+//go:build test_unit
+
+package daemon
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/audio"
+	"github.com/devgianlu/go-librespot/dealer"
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+	"github.com/devgianlu/go-librespot/tracks"
+	"github.com/stretchr/testify/require"
+)
+
+// A prefetch can be refused after Connect has claimed its new context but
+// before the queued transfer resolves. The cooldown must not leave the new
+// context paired with the old context's track list or lose the transfer data.
+func refusePrefetchAfterTransferClaim(t *testing.T, p *AppPlayer, req dealer.RequestPayload) {
+	t.Helper()
+	playingTrack(t, p, jamTrackUri, "old")
+	oldContext := &connectpb.Context{
+		Uri: p.state.player.ContextUri,
+		Pages: []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{
+			{Uri: jamTrackUri, Uid: "old"},
+		}}},
+	}
+	var err error
+	p.state.tracks, err = tracks.NewTrackListFromContext(t.Context(), &librespot.NullLogger{}, nil, oldContext)
+	require.NoError(t, err)
+	require.True(t, p.state.tracks.GoStart(t.Context()))
+	prefetchGen := p.prefetchGen
+
+	require.NoError(t, p.handlePlayerCommand(req))
+	require.True(t, p.state.player.IsBuffering)
+	require.Len(t, p.loader.queue, 1)
+
+	res := p.loader.execute(loaderJob{
+		name:  "prefetch refused while transfer is queued",
+		class: classPrefetch,
+		gen:   prefetchGen,
+		run: func(context.Context) loaderResult {
+			return loaderResult{err: &audio.KeyProviderError{Code: 2}}
+		},
+	}, t.Context())
+	require.Empty(t, p.loader.queue, "the pending transfer cannot run during cooldown")
+	p.applyLoaderResult(res)
+	require.NotNil(t, p.playbackFailure)
+	require.False(t, p.state.player.IsBuffering)
+	require.False(t, p.state.player.IsPlaying)
+	require.Nil(t, p.state.tracks, "the previous context's list must not survive the new claim")
+	require.ErrorIs(t, p.play(), errPlaybackCooldown)
+	require.Empty(t, p.loader.queue)
+
+	p.loader.mu.Lock()
+	p.loader.audioKeyRetryAt = time.Now().Add(-time.Second)
+	p.loader.mu.Unlock()
+	require.NoError(t, p.play())
+	require.Len(t, p.loader.queue, 1, "an explicit retry resolves the retained transfer first")
+	runQueuedJob(t, p)
+}
+
+func TestRecoveryRetryPreservesTransferredPlayingQueue(t *testing.T) {
+	p := newTestAppPlayer(t)
+	p.resolveTrackList = resolveWith(0)
+	req := playingQueueTransfer(t, "do_not_retain", "u1")
+
+	refusePrefetchAfterTransferClaim(t, p, req)
+
+	require.Equal(t, queuedUri, p.state.player.Track.GetUri())
+	require.Equal(t, queuedUri, p.state.tracks.CurrentTrack().GetUri())
+	require.Equal(t, "queue", p.state.tracks.CurrentTrack().GetProvider())
+	require.Equal(t, []string{"spotify:track:2infXICqVSUM3bbGSOgFOY", "spotify:track:11hcBLPtbMp4aQI6zGQLub"},
+		trackUris(p.state.player.NextTracks))
+	require.Len(t, p.loader.queue, 1)
+	require.Equal(t, "load "+queuedUri, p.loader.queue[0].name)
+	require.NotNil(t, p.playbackFailure, "only a successful media load confirms recovery")
+}
+
+func TestRecoveryRetryResolvesTransferWithoutCurrentTrack(t *testing.T) {
+	p := newTestAppPlayer(t)
+	p.resolveTrackList = resolveWith(0)
+	const nextUri = "spotify:track:3CRDbSIZ4r5MsZ0YwxuEkn"
+	req := transferCommand(t, &connectpb.TransferState{
+		Options: &connectpb.ContextPlayerOptions{},
+		CurrentSession: &connectpb.Session{Context: &connectpb.Context{
+			Uri: "spotify:playlist:37i9dQZF1DX8vwRmUsEIMT",
+			Pages: []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{
+				{Uri: nextUri, Uid: "u0"},
+			}}},
+		}},
+		Playback: &connectpb.Playback{Timestamp: time.Now().UnixMilli()},
+	})
+
+	refusePrefetchAfterTransferClaim(t, p, req)
+
+	require.Equal(t, nextUri, p.state.player.Track.GetUri())
+	require.Equal(t, nextUri, p.state.tracks.CurrentTrack().GetUri())
+	require.Len(t, p.loader.queue, 1)
+	require.Equal(t, "load "+nextUri, p.loader.queue[0].name)
+}
+
+func TestRecoveryRetryResolverFailurePreservesAnotherManualRetry(t *testing.T) {
+	p := newTestAppPlayer(t)
+	p.resolveTrackList = failResolve
+	req := playingQueueTransfer(t, "do_not_retain", "u1")
+
+	// The first explicit recovery attempt fails to resolve the retained
+	// transfer, before any new media request is made.
+	refusePrefetchAfterTransferClaim(t, p, req)
+
+	require.False(t, p.state.player.IsPlaying)
+	require.False(t, p.state.player.IsBuffering, "a failed resolver must not leave recovery stuck retrying")
+	require.True(t, p.state.player.IsPaused)
+	require.Equal(t, "spotify:playlist:37i9dQZF1DX8vwRmUsEIMT", p.state.player.ContextUri)
+	require.Equal(t, queuedUri, p.state.player.Track.GetUri())
+	require.NotNil(t, p.retryContext, "the failed resolver must retain the original transfer")
+	require.NotNil(t, p.playbackFailure)
+	require.Equal(t, playbackErrorKindAudioKeyRefused, p.playbackFailure.Kind)
+	require.Zero(t, p.apiPlaybackError().RetryAfterMs, "an ordinary resolver failure does not renew the key cooldown")
+	require.Nil(t, p.state.tracks)
+	require.Empty(t, p.loader.queue)
+
+	// Until that context is resolved, relative controls cannot fall through
+	// to autoplay or navigate the previous context's list.
+	gen := p.loadGen
+	require.ErrorIs(t, p.skipNext(nil), ErrNoContext)
+	require.ErrorIs(t, p.skipPrev(true), ErrNoContext)
+	require.Equal(t, gen, p.loadGen)
+	require.Empty(t, p.loader.queue)
+	require.Equal(t, queuedUri, p.state.player.Track.GetUri())
+
+	p.resolveTrackList = resolveWith(0)
+	require.NoError(t, p.play(), "another Space must be able to retry")
+	require.True(t, p.state.player.IsBuffering)
+	runQueuedJob(t, p)
+	require.Equal(t, queuedUri, p.state.tracks.CurrentTrack().GetUri())
+	require.Equal(t, "queue", p.state.tracks.CurrentTrack().GetProvider())
+	require.Equal(t, []string{"spotify:track:2infXICqVSUM3bbGSOgFOY", "spotify:track:11hcBLPtbMp4aQI6zGQLub"},
+		trackUris(p.state.player.NextTracks))
+	require.Len(t, p.loader.queue, 1)
+	require.Equal(t, "load "+queuedUri, p.loader.queue[0].name)
+}
