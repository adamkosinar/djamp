index 0000000..ff905d3
--- /dev/null
+++ b/daemon/dj_context.go
@@ -0,0 +1,262 @@
+package daemon
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net/url"
+	"path"
+	"strings"
+	"time"
+
+	librespot "github.com/devgianlu/go-librespot"
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+	"github.com/devgianlu/go-librespot/tracks"
+	"google.golang.org/protobuf/proto"
+)
+
+const djContextURI = "spotify:playlist:37i9dQZF1EYkqdzj48dyYq"
+
+type playContextResolver interface {
+	ContextResolve(context.Context, string) (*connectpb.Context, error)
+	ContextResolveUrl(context.Context, string) (*connectpb.Context, error)
+	ContextPage(context.Context, string) (*connectpb.ContextPage, error)
+}
+
+// DJ's playlist is a session entry point, not an ordinary playlist: resolving
+// it as a playlist yields an empty context. The session provider supplies the
+// narration, tracks and continuation URLs used by the existing DJ player.
+// Request an interactive load rather than restoring the previous session.
+func resolvePlayContext(ctx context.Context, resolver playContextResolver, uri string) (*connectpb.Context, error) {
+	if uri == djContextURI {
+		spotCtx, err := resolver.ContextResolveUrl(ctx,
+			"hm://lexicon-session-provider/context-resolve/v2/session?contextUri="+uri+"&reason=interactive")
+		if err != nil {
+			return nil, err
+		}
+		if spotCtx == nil || spotCtx.Uri != djContextURI {
+			return nil, errors.New("DJ session response is empty")
+		}
+		if spotCtx.Loading {
+			return nil, errors.New("DJ session is still loading; try again")
+		}
+		return spotCtx, nil
+	}
+	return resolver.ContextResolve(ctx, uri)
+}
+
+// Accept only Spotify's DJ pagination service, never arbitrary cached URLs.
+// Keeping the original URL preserves server-issued query parameters verbatim.
+func validDJPageURL(raw string) bool {
+	if len(raw) == 0 || len(raw) > 16384 {
+		return false
+	}
+	u, err := url.Parse(raw)
+	if err != nil || u.Scheme != "hm" || u.Host != "lexicon-session-provider" || u.User != nil ||
+		u.Fragment != "" || u.Opaque != "" || u.RawPath != "" || path.Clean(u.Path) != u.Path ||
+		!strings.HasPrefix(u.Path, "/context-resolve/v2/session/") || strings.HasSuffix(u.Path, "/") {
+		return false
+	}
+	query, err := url.ParseQuery(u.RawQuery)
+	return err == nil && len(query["contextUri"]) == 1 && query.Get("contextUri") == djContextURI
+}
+
+func validDJPage(page *connectpb.ContextPage) bool {
+	if page == nil || len(page.Tracks) == 0 || !validDJPageURL(page.NextPageUrl) {
+		return false
+	}
+	for _, track := range page.Tracks {
+		if track == nil || track.Uri == "" && len(track.Gid) == 0 {
+			return false
+		}
+	}
+	return true
+}
+
+// Combine the returned correlation-id with opening track order to recognize
+// an unchanged root. Exclude dynamic metadata such as current time,
+// pagination state and occurrence UIDs, which need not identify a generation.
+func djRootFingerprint(root *connectpb.Context) string {
+	correlationID := root.Metadata["correlation-id"]
+	if correlationID == "" {
+		correlationID = root.Pages[0].Metadata["correlation-id"]
+	}
+	identity := struct {
+		CorrelationID string
+		Tracks        []string
+	}{CorrelationID: correlationID}
+	for _, track := range root.Pages[0].Tracks {
+		identity.Tracks = append(identity.Tracks, track.Uri+":"+hex.EncodeToString(track.Gid))
+	}
+	encoded, _ := json.Marshal(identity)
+	fingerprint := sha256.Sum256(encoded)
+	return hex.EncodeToString(fingerprint[:])
+}
+
+type djPageError struct{ cause error }
+
+func (err djPageError) Error() string { return "could not fetch the next Spotify DJ set; retry later" }
+func (err djPageError) Unwrap() error { return err.cause }
+
+// Spotify can return a lazy opening or continuation: an empty page carrying
+// the server URL of its tracks. Follow a bounded number of those pointers,
+// preserving their query verbatim and rejecting loops or other services.
+func materializeDJPage(ctx context.Context, resolver playContextResolver, page *connectpb.ContextPage) (*connectpb.ContextPage, error) {
+	visited := make(map[string]bool)
+	for follows := 0; page != nil && len(page.Tracks) == 0; follows++ {
+		if follows >= 3 {
+			return nil, errors.New("Spotify DJ returned too many empty pages; retry later")
+		}
+		next := page.PageUrl
+		if next == "" || visited[next] {
+			next = page.NextPageUrl
+		}
+		if !validDJPageURL(next) || visited[next] {
+			return nil, errors.New("Spotify DJ returned an invalid page continuation")
+		}
+		visited[next] = true
+		var err error
+		page, err = resolver.ContextPage(ctx, next)
+		if err != nil {
+			return nil, djPageError{cause: err}
+		}
+	}
+	if !validDJPage(page) || visited[page.NextPageUrl] {
+		return nil, errors.New("Spotify DJ returned an invalid next set; retry later")
+	}
+	return page, nil
+}
+
+// resolveDJStart advances an unchanged Spotify root to its saved next set.
+// Nothing is persisted here: resolving or prefetching is not playing.
+func resolveDJStart(ctx context.Context, resolver playContextResolver, uri string, saved *librespot.DJCursor) (*connectpb.Context, string, error) {
+	if uri != djContextURI {
+		resolved, err := resolvePlayContext(ctx, resolver, uri)
+		return resolved, "", err
+	}
+	ctx, cancel := context.WithTimeout(ctx, 15*time.Second)
+	defer cancel()
+	root, err := resolvePlayContext(ctx, resolver, uri)
+	if err != nil {
+		return nil, "", err
+	}
+	if len(root.Pages) == 0 {
+		return nil, "", errors.New("Spotify DJ returned an invalid starting set")
+	}
+	opening, err := materializeDJPage(ctx, resolver, root.Pages[0])
+	if err != nil {
+		return nil, "", err
+	}
+	root = proto.Clone(root).(*connectpb.Context)
+	root.Pages[0] = opening
+	if root.Metadata == nil {
+		root.Metadata = make(map[string]string)
+	}
+	// A lazy root carries welcome metadata, while its resolved page supplies
+	// the selection's correlation ID and colors. Keep both, preferring root
+	// keys when Spotify already supplied them there.
+	for key, value := range opening.Metadata {
+		if _, exists := root.Metadata[key]; !exists {
+			root.Metadata[key] = value
+		}
+	}
+	fingerprint := djRootFingerprint(root)
+	if saved == nil || saved.RootFingerprint != fingerprint {
+		return root, fingerprint, nil
+	}
+	if !validDJPageURL(saved.NextPageURL) {
+		return nil, "", errors.New("saved Spotify DJ continuation is unavailable; wait for a new Spotify selection")
+	}
+	page, err := materializeDJPage(ctx, resolver, &connectpb.ContextPage{NextPageUrl: saved.NextPageURL})
+	if err != nil {
+		return nil, "", err
+	}
+	resolved := proto.Clone(root).(*connectpb.Context)
+	resolved.Pages = []*connectpb.ContextPage{page}
+	return resolved, fingerprint, nil
+}
+
+type djPlayback struct {
+	username        string
+	rootFingerprint string
+	pending         *djPagePosition
+	loaded          *djPagePosition
+}
+
+type djPagePosition struct {
+	nextPageURL string
+	trackURI    string
+	trackUID    string
+}
+
+func (app *App) djCursor(username string) *librespot.DJCursor {
+	app.stateMu.Lock()
+	defer app.stateMu.Unlock()
+	if app.state == nil {
+		return nil
+	}
+	app.state.Lock()
+	defer app.state.Unlock()
+	cursor, exists := app.state.DJCursors[username]
+	if !exists {
+		return nil
+	}
+	return &cursor
+}
+
+func (app *App) updateDJCursor(username string, cursor librespot.DJCursor) bool {
+	app.stateMu.Lock()
+	defer app.stateMu.Unlock()
+	if app.state == nil || username == "" {
+		return false
+	}
+	app.state.Lock()
+	defer app.state.Unlock()
+	if app.state.DJCursors == nil {
+		app.state.DJCursors = make(map[string]librespot.DJCursor)
+	}
+	if app.state.DJCursors[username] == cursor {
+		return false
+	}
+	app.state.DJCursors[username] = cursor
+	return true
+}
+
+func (p *AppPlayer) rememberDJPage(snap *tracks.Snapshot) {
+	if p.djPlayback == nil {
+		return
+	}
+	track := snap.Current
+	p.djPlayback.pending = nil
+	if snap.HasPageContinuation && track != nil && validDJPageURL(snap.PageNextURL) {
+		p.djPlayback.pending = &djPagePosition{nextPageURL: snap.PageNextURL, trackURI: track.Uri, trackUID: track.Uid}
+	}
+}
+
+func (p *AppPlayer) markDJLoaded(uri string) {
+	if p.djPlayback == nil {
+		return
+	}
+	p.djPlayback.loaded = nil
+	position := p.djPlayback.pending
+	if position != nil && position.trackURI == uri && position.trackUID == p.state.player.Track.GetUid() {
+		copy := *position
+		p.djPlayback.loaded = &copy
+	}
+}
+
+// Called only after a successful unpaused load or successful resume. Failed
+// loads, queued tracks and snapshots built for prefetch never consume a set.
+func (p *AppPlayer) commitDJCursor() {
+	dj := p.djPlayback
+	if dj == nil || dj.loaded == nil || p.state.player.ContextUri != djContextURI || p.state.player.IsPaused {
+		return
+	}
+	if p.app.updateDJCursor(dj.username, librespot.DJCursor{
+		RootFingerprint: dj.rootFingerprint, NextPageURL: dj.loaded.nextPageURL,
+	}) {
+		p.app.requestPersist()
+	}
+}
diff --git a/daemon/dj_context_test.go b/daemon/dj_context_test.go
new file mode 100644
index 0000000..a4c4d3d
--- /dev/null
+++ b/daemon/dj_context_test.go
@@ -0,0 +1,132 @@
+//go:build test_unit
+
+package daemon
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+	"github.com/stretchr/testify/require"
+)
+
+type recordingPlayResolver struct {
+	ctx    context.Context
+	uris   []string
+	urls   []string
+	result *connectpb.Context
+	err    error
+}
+
+func (r *recordingPlayResolver) ContextResolve(ctx context.Context, uri string) (*connectpb.Context, error) {
+	r.ctx = ctx
+	r.uris = append(r.uris, uri)
+	return r.result, r.err
+}
+
+func (r *recordingPlayResolver) ContextResolveUrl(ctx context.Context, url string) (*connectpb.Context, error) {
+	r.ctx = ctx
+	r.urls = append(r.urls, url)
+	return r.result, r.err
+}
+
+func (r *recordingPlayResolver) ContextPage(context.Context, string) (*connectpb.ContextPage, error) {
+	panic("unexpected context page request")
+}
+
+func TestResolvePlayContextDJ(t *testing.T) {
+	want := &connectpb.Context{
+		Uri:      djContextURI,
+		Url:      "hm://lexicon-session-provider/context-resolve/v2/session/test",
+		Metadata: map[string]string{"lexicon_set_type": "your_dj"},
+		Pages: []*connectpb.ContextPage{{
+			NextPageUrl: "hm://lexicon-session-provider/next",
+			Tracks: []*connectpb.ContextTrack{{
+				Uri: "spotify:track:test",
+				Metadata: map[string]string{
+					"narration.intro.ssml": "test intro",
+					"narration.jump.ssml":  "test jump",
+				},
+			}},
+		}},
+	}
+	r := &recordingPlayResolver{result: want}
+	ctx := t.Context()
+	got, err := resolvePlayContext(ctx, r, djContextURI)
+	require.NoError(t, err)
+	require.Same(t, want, got, "preserve session metadata and continuation pages")
+	require.Same(t, ctx, r.ctx)
+	require.Equal(t, []string{"hm://lexicon-session-provider/context-resolve/v2/session?contextUri=" + djContextURI + "&reason=interactive"}, r.urls)
+	require.Empty(t, r.uris)
+}
+
+func TestResolvePlayContextDJNotReady(t *testing.T) {
+	for _, tt := range []struct {
+		name   string
+		result *connectpb.Context
+	}{
+		{name: "empty"},
+		{name: "loading", result: &connectpb.Context{
+			Uri:     djContextURI,
+			Loading: true,
+			// Even a response with usable tracks must not bypass Loading.
+			Pages: []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{{Uri: "spotify:track:test"}}}},
+		}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			r := &recordingPlayResolver{result: tt.result}
+			got, err := resolvePlayContext(t.Context(), r, djContextURI)
+			require.Nil(t, got)
+			require.ErrorContains(t, err, tt.name)
+			require.Len(t, r.urls, 1)
+			require.Empty(t, r.uris, "do not fall back to restoring an old session")
+		})
+	}
+}
+
+func TestResolvePlayContextOrdinary(t *testing.T) {
+	for _, uri := range []string{
+		"spotify:playlist:ordinary",
+		"spotify:album:ordinary",
+		"spotify:track:ordinary",
+		djContextURI + "extra",
+	} {
+		t.Run(uri, func(t *testing.T) {
+			want := &connectpb.Context{Uri: uri}
+			r := &recordingPlayResolver{result: want}
+			ctx := t.Context()
+			got, err := resolvePlayContext(ctx, r, uri)
+			require.NoError(t, err)
+			require.Same(t, want, got)
+			require.Same(t, ctx, r.ctx)
+			require.Equal(t, []string{uri}, r.uris)
+			require.Empty(t, r.urls)
+		})
+	}
+}
+
+func TestResolvePlayContextError(t *testing.T) {
+	for _, uri := range []string{djContextURI, "spotify:album:ordinary"} {
+		t.Run(uri, func(t *testing.T) {
+			want := errors.New("session unavailable")
+			r := &recordingPlayResolver{err: want}
+			got, err := resolvePlayContext(t.Context(), r, uri)
+			require.Nil(t, got)
+			require.ErrorIs(t, err, want)
+			require.Equal(t, 1, len(r.uris)+len(r.urls), "do not fall back to an empty DJ playlist")
+		})
+	}
+}
+
+func TestPlayerRootAdvertisesDirectDJBeforeAndAfterReady(t *testing.T) {
+	p := newTestAppPlayer(t)
+	p.playbackReadyCh = make(chan struct{})
+	resp, err := p.handleApiRequest(ApiRequest{Type: ApiRequestTypeRoot})
+	require.NoError(t, err)
+	require.Equal(t, &ApiRoot{DirectDj: true, Library: true}, resp)
+	close(p.playbackReadyCh)
+	resp, err = p.handleApiRequest(ApiRequest{Type: ApiRequestTypeRoot})
+	require.NoError(t, err)
+	require.Equal(t, &ApiRoot{PlaybackReady: true, DirectDj: true, Library: true}, resp)
+}
diff --git a/daemon/dj_start_test.go b/daemon/dj_start_test.go
new file mode 100644
index 0000000..eda477f
--- /dev/null
+++ b/daemon/dj_start_test.go
@@ -0,0 +1,353 @@
+//go:build test_unit
+
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	librespot "github.com/devgianlu/go-librespot"
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+	"github.com/devgianlu/go-librespot/tracks"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/protobuf/proto"
+)
+
+func djPageURL(page int) string {
+	return fmt.Sprintf("hm://lexicon-session-provider/context-resolve/v2/session/test?contextUri=%s&previousSegmentId=set%d", djContextURI, page)
+}
+
+func djTestPage(page int) *connectpb.ContextPage {
+	return &connectpb.ContextPage{
+		PageUrl: djPageURL(page), NextPageUrl: djPageURL(page + 1),
+		Tracks: []*connectpb.ContextTrack{{
+			Uri: fmt.Sprintf("spotify:track:track%d", page), Uid: fmt.Sprintf("set%d-occurrence", page),
+			Metadata: map[string]string{"narration.intro.ssml": "server intro", "narration.jump.ssml": "server jump"},
+		}},
+	}
+}
+
+func djTestRoot() *connectpb.Context {
+	return &connectpb.Context{
+		Uri: djContextURI, Url: "hm://lexicon-session-provider/context-resolve/v2/session?contextUri=" + djContextURI,
+		Metadata:     map[string]string{"correlation-id": "root-generation", "lexicon_current_time": "100", "lexicon_set_type": "your_dj"},
+		Restrictions: &connectpb.Restrictions{DisallowTogglingShuffleReasons: []string{"dj"}},
+		Pages:        []*connectpb.ContextPage{djTestPage(0)},
+	}
+}
+
+type djSequenceResolver struct {
+	root      *connectpb.Context
+	pages     map[string]*connectpb.ContextPage
+	requested []string
+	err       error
+	deadline  bool
+}
+
+func (r *djSequenceResolver) ContextResolve(context.Context, string) (*connectpb.Context, error) {
+	return nil, errors.New("unexpected ordinary context resolve")
+}
+
+func (r *djSequenceResolver) ContextResolveUrl(ctx context.Context, raw string) (*connectpb.Context, error) {
+	if !strings.HasSuffix(raw, "&reason=interactive") {
+		return nil, errors.New("missing interactive reason")
+	}
+	_, r.deadline = ctx.Deadline()
+	return r.root, nil
+}
+
+func (r *djSequenceResolver) ContextPage(ctx context.Context, raw string) (*connectpb.ContextPage, error) {
+	r.requested = append(r.requested, raw)
+	if ctx.Err() != nil {
+		return nil, ctx.Err()
+	}
+	if r.err != nil {
+		return nil, r.err
+	}
+	return r.pages[raw], nil
+}
+
+func newDJSequence() *djSequenceResolver {
+	r := &djSequenceResolver{root: djTestRoot(), pages: make(map[string]*connectpb.ContextPage)}
+	for page := 1; page < 6; page++ {
+		r.pages[djPageURL(page)] = djTestPage(page)
+	}
+	return r
+}
+
+func TestDJThreeLaunchesUseConsecutiveServerSets(t *testing.T) {
+	r := newDJSequence()
+	var saved *librespot.DJCursor
+	var originalRoot string
+	for launch := 0; launch < 3; launch++ {
+		resolved, root, err := resolveDJStart(t.Context(), r, djContextURI, saved)
+		require.NoError(t, err)
+		if launch == 0 {
+			originalRoot = root
+		}
+		require.Equal(t, originalRoot, root)
+		require.True(t, r.deadline)
+		require.Equal(t, fmt.Sprintf("spotify:track:track%d", launch), resolved.Pages[0].Tracks[0].Uri)
+		require.Equal(t, "server intro", resolved.Pages[0].Tracks[0].Metadata["narration.intro.ssml"])
+		require.Equal(t, r.root.Metadata, resolved.Metadata)
+		require.True(t, proto.Equal(r.root.Restrictions, resolved.Restrictions))
+		// The owner records this only after the returned page starts playing.
+		saved = &librespot.DJCursor{RootFingerprint: root, NextPageURL: resolved.Pages[0].NextPageUrl}
+	}
+	require.Equal(t, []string{djPageURL(1), djPageURL(2)}, r.requested)
+	require.Equal(t, "spotify:track:track0", r.root.Pages[0].Tracks[0].Uri, "do not mutate the root while selecting a later page")
+}
+
+func TestDJNewRootAndAccountIgnoreOldCursor(t *testing.T) {
+	r := newDJSequence()
+	_, root, err := resolveDJStart(t.Context(), r, djContextURI, nil)
+	require.NoError(t, err)
+	app := &App{state: &librespot.AppState{}}
+	saved := librespot.DJCursor{RootFingerprint: root, NextPageURL: djPageURL(3)}
+	require.True(t, app.updateDJCursor("account-a", saved))
+	require.False(t, app.updateDJCursor("account-a", saved), "save once per current page")
+	require.Nil(t, app.djCursor("account-b"))
+	resolved, _, err := resolveDJStart(t.Context(), r, djContextURI, app.djCursor("account-b"))
+	require.NoError(t, err)
+	require.Equal(t, "spotify:track:track0", resolved.Pages[0].Tracks[0].Uri)
+	r.root.Metadata["correlation-id"] = "new-generation"
+	resolved, newRoot, err := resolveDJStart(t.Context(), r, djContextURI, app.djCursor("account-a"))
+	require.NoError(t, err)
+	require.NotEqual(t, root, newRoot)
+	require.Equal(t, "spotify:track:track0", resolved.Pages[0].Tracks[0].Uri)
+	require.Empty(t, r.requested)
+	require.Equal(t, &saved, app.djCursor("account-a"), "resolution alone must not change persisted state")
+}
+
+func TestDJFingerprintIgnoresClockAndUIDButDetectsOpeningChange(t *testing.T) {
+	root := djTestRoot()
+	fingerprint := djRootFingerprint(root)
+	root.Metadata["lexicon_current_time"] = "999"
+	root.Pages[0].Tracks[0].Uid = "different-occurrence"
+	require.Equal(t, fingerprint, djRootFingerprint(root))
+	root.Pages[0].Tracks[0].Uri = "spotify:track:changed"
+	require.NotEqual(t, fingerprint, djRootFingerprint(root))
+}
+
+func TestDJLazyRootAndPopulatedRootShareCursorIdentity(t *testing.T) {
+	r := newDJSequence()
+	r.root.Metadata = map[string]string{"narration.welcome.ssml": "server welcome"}
+	r.root.Pages = []*connectpb.ContextPage{{NextPageUrl: djPageURL(0)}}
+	firstPage := djTestPage(0)
+	firstPage.Metadata = map[string]string{"correlation-id": "root-generation", "color": "blue"}
+	r.pages[djPageURL(0)] = firstPage
+	resolved, root, err := resolveDJStart(t.Context(), r, djContextURI, nil)
+	require.NoError(t, err)
+	require.Equal(t, "server welcome", resolved.Metadata["narration.welcome.ssml"])
+	require.Equal(t, "root-generation", resolved.Metadata["correlation-id"])
+	require.Equal(t, "blue", resolved.Pages[0].Metadata["color"])
+	require.Equal(t, "server intro", resolved.Pages[0].Tracks[0].Metadata["narration.intro.ssml"])
+	saved := &librespot.DJCursor{RootFingerprint: root, NextPageURL: resolved.Pages[0].NextPageUrl}
+	r.root = djTestRoot() // Spotify now returns the same opening directly.
+	resolved, nextRoot, err := resolveDJStart(t.Context(), r, djContextURI, saved)
+	require.NoError(t, err)
+	require.Equal(t, root, nextRoot)
+	require.Equal(t, "spotify:track:track1", resolved.Pages[0].Tracks[0].Uri)
+	require.Equal(t, []string{djPageURL(0), djPageURL(1)}, r.requested)
+}
+
+func TestDJLazyPagesAreBoundedAndCycleChecked(t *testing.T) {
+	for _, cycle := range []bool{false, true} {
+		r := newDJSequence()
+		r.root.Pages = []*connectpb.ContextPage{{NextPageUrl: djPageURL(0)}}
+		for page := 0; page < 4; page++ {
+			next := page + 1
+			if cycle {
+				next = 0
+			}
+			r.pages[djPageURL(page)] = &connectpb.ContextPage{PageUrl: djPageURL(page), NextPageUrl: djPageURL(next)}
+		}
+		resolved, _, err := resolveDJStart(t.Context(), r, djContextURI, nil)
+		require.Error(t, err)
+		require.Nil(t, resolved)
+		require.LessOrEqual(t, len(r.requested), 3)
+	}
+}
+
+func TestDJContinuationFailureNeverFallsBackOrLeaksURL(t *testing.T) {
+	r := newDJSequence()
+	saved := &librespot.DJCursor{RootFingerprint: djRootFingerprint(r.root), NextPageURL: djPageURL(1)}
+	want := errors.New("failed GET " + saved.NextPageURL)
+	r.err = want
+	resolved, _, err := resolveDJStart(t.Context(), r, djContextURI, saved)
+	require.Nil(t, resolved)
+	require.ErrorIs(t, err, want)
+	require.NotContains(t, err.Error(), saved.NextPageURL)
+	require.Equal(t, djPageURL(1), saved.NextPageURL)
+	require.Len(t, r.requested, 1)
+}
+
+func TestDJContinuationRespectsCancellation(t *testing.T) {
+	r := newDJSequence()
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	_, _, err := resolveDJStart(ctx, r, djContextURI, &librespot.DJCursor{RootFingerprint: djRootFingerprint(r.root), NextPageURL: djPageURL(1)})
+	require.ErrorIs(t, err, context.Canceled)
+}
+
+func TestDJRejectsMalformedRootAndPage(t *testing.T) {
+	for _, invalid := range []*connectpb.Context{nil, {}, {Uri: "spotify:album:other"}, {Uri: djContextURI},
+		{Uri: djContextURI, Loading: true, Pages: []*connectpb.ContextPage{djTestPage(0)}},
+		{Uri: djContextURI, Pages: []*connectpb.ContextPage{nil}},
+		{Uri: djContextURI, Pages: []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{{Uri: "spotify:track:x"}}}}},
+	} {
+		r := newDJSequence()
+		r.root = invalid
+		resolved, _, err := resolveDJStart(t.Context(), r, djContextURI, nil)
+		require.Error(t, err)
+		require.Nil(t, resolved)
+	}
+	for _, invalid := range []*connectpb.ContextPage{nil, {}, {NextPageUrl: "https://untrusted.invalid/page"},
+		{NextPageUrl: djPageURL(2), Tracks: []*connectpb.ContextTrack{nil}},
+		{NextPageUrl: djPageURL(1), Tracks: []*connectpb.ContextTrack{{Uri: "spotify:track:x"}}},
+	} {
+		r := newDJSequence()
+		r.pages[djPageURL(1)] = invalid
+		resolved, _, err := resolveDJStart(t.Context(), r, djContextURI, &librespot.DJCursor{RootFingerprint: djRootFingerprint(r.root), NextPageURL: djPageURL(1)})
+		require.Error(t, err)
+		require.Nil(t, resolved)
+	}
+}
+
+func TestDJRejectsUntrustedContinuationBeforeRequest(t *testing.T) {
+	for _, raw := range []string{"", "https://example.com/private", "hm://evil/context-resolve/v2/session/id?contextUri=" + djContextURI,
+		"hm://user@lexicon-session-provider/context-resolve/v2/session/id?contextUri=" + djContextURI,
+		djPageURL(1) + "#fragment", strings.Replace(djPageURL(1), "/session/test", "/session/../other", 1),
+		strings.Replace(djPageURL(1), "contextUri="+djContextURI, "contextUri=spotify:playlist:other", 1),
+	} {
+		r := newDJSequence()
+		_, _, err := resolveDJStart(t.Context(), r, djContextURI, &librespot.DJCursor{RootFingerprint: djRootFingerprint(r.root), NextPageURL: raw})
+		require.Error(t, err)
+		require.Empty(t, r.requested)
+	}
+}
+
+type djMemoryStore struct {
+	mu   sync.Mutex
+	data []byte
+}
+
+func (s *djMemoryStore) Load() (*librespot.AppState, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	state := &librespot.AppState{}
+	if len(s.data) == 0 {
+		return state, nil
+	}
+	return state, json.Unmarshal(s.data, state)
+}
+func (s *djMemoryStore) Save(state *librespot.AppState) error {
+	state.Lock()
+	defer state.Unlock()
+	data, err := json.Marshal(state)
+	if err != nil {
+		return err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.data = data
+	return nil
+}
+
+func TestDJOnlyLoadedUnpausedPageAdvancesAndCloseFlushes(t *testing.T) {
+	p := newTestAppPlayer(t)
+	store := &djMemoryStore{}
+	p.app.state = &librespot.AppState{}
+	p.app.stateStore = store
+	p.djPlayback = &djPlayback{username: "account-a", rootFingerprint: "root"}
+	p.state.player.ContextUri = djContextURI
+	setPage := func(page int) {
+		track := &connectpb.ProvidedTrack{Uri: fmt.Sprintf("spotify:track:track%d", page), Uid: fmt.Sprintf("set%d", page)}
+		p.state.player.Track = track
+		p.rememberDJPage(&tracks.Snapshot{Current: track, HasPageContinuation: true, PageNextURL: djPageURL(page + 1)})
+	}
+	setPage(0)
+	p.commitDJCursor()
+	require.Nil(t, p.app.djCursor("account-a"), "prefetch/snapshot is not a successful load")
+	p.markDJLoaded(p.state.player.Track.Uri)
+	p.state.setPaused(true)
+	p.commitDJCursor()
+	require.Nil(t, p.app.djCursor("account-a"), "a paused-only load has not played")
+	p.state.setPaused(false)
+	p.commitDJCursor()
+	require.Equal(t, djPageURL(1), p.app.djCursor("account-a").NextPageURL)
+	setPage(2) // page 2 is selected, but its load fails; page 0 remains loaded.
+	p.commitDJCursor()
+	require.Equal(t, djPageURL(1), p.app.djCursor("account-a").NextPageURL)
+	p.markDJLoaded(p.state.player.Track.Uri) // later, page 2 really loads.
+	p.commitDJCursor()
+	require.Equal(t, djPageURL(3), p.app.djCursor("account-a").NextPageURL)
+	p.rememberDJPage(&tracks.Snapshot{Current: &connectpb.ProvidedTrack{Uri: "spotify:track:queued"}})
+	p.markDJLoaded("spotify:track:queued")
+	p.commitDJCursor()
+	require.Equal(t, djPageURL(3), p.app.djCursor("account-a").NextPageURL, "queued/injected track is not a DJ page")
+	// No sleep: shutdown itself must flush the latest bookmark.
+	require.NoError(t, p.app.Close())
+	state, err := store.Load()
+	require.NoError(t, err)
+	require.Equal(t, djPageURL(3), state.DJCursors["account-a"].NextPageURL)
+	require.Eventually(t, func() bool { p.app.stateMu.Lock(); defer p.app.stateMu.Unlock(); return !p.app.saving }, time.Second, time.Millisecond)
+}
+
+type djBlockingStore struct {
+	entered chan struct{}
+	release chan struct{}
+	once    sync.Once
+}
+
+func (s *djBlockingStore) Load() (*librespot.AppState, error) { return &librespot.AppState{}, nil }
+func (s *djBlockingStore) Save(*librespot.AppState) error {
+	s.once.Do(func() { close(s.entered) })
+	<-s.release
+	return nil
+}
+
+func TestDJConcurrentCloseWaitsForStateFlush(t *testing.T) {
+	store := &djBlockingStore{entered: make(chan struct{}), release: make(chan struct{})}
+	app := &App{state: &librespot.AppState{}, stateStore: store}
+	first, second := make(chan error, 1), make(chan error, 1)
+	go func() { first <- app.Close() }()
+	select {
+	case <-store.entered:
+	case <-time.After(time.Second):
+		t.Fatal("first close did not enter the state flush")
+	}
+	go func() { second <- app.Close() }()
+	select {
+	case <-second:
+		t.Fatal("concurrent close returned before the state was saved")
+	case <-time.After(20 * time.Millisecond):
+	}
+	close(store.release)
+	for _, done := range []chan error{first, second} {
+		select {
+		case err := <-done:
+			require.NoError(t, err)
+		case <-time.After(time.Second):
+			t.Fatal("close did not finish after the state was saved")
+		}
+	}
+}
+
+func TestDJFinalCloseFlushesAfterEarlyResourceClose(t *testing.T) {
+	store := &djMemoryStore{}
+	app := &App{state: &librespot.AppState{}, stateStore: store}
+	require.NoError(t, app.Close()) // cancellation goroutine closes early
+	cursor := librespot.DJCursor{RootFingerprint: "root", NextPageURL: djPageURL(3)}
+	require.True(t, app.updateDJCursor("account-a", cursor)) // last player commit
+	require.NoError(t, app.Close())                          // command defer runs after player Run returns
+	state, err := store.Load()
+	require.NoError(t, err)
+	require.Equal(t, cursor, state.DJCursors["account-a"])
+}
diff --git a/daemon/library.go b/daemon/library.go
new file mode 100644
index 0000000..79f544b
--- /dev/null
+++ b/daemon/library.go
@@ -0,0 +1,343 @@
+package daemon
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"math/big"
+	"sort"
+	"strings"
+	"time"
+
+	librespot "github.com/devgianlu/go-librespot"
+	collectionpb "github.com/devgianlu/go-librespot/proto/spotify/collection/v2"
+	metadatapb "github.com/devgianlu/go-librespot/proto/spotify/metadata"
+	"github.com/devgianlu/go-librespot/spclient"
+	"github.com/google/uuid"
+)
+
+const libraryTimeout = 25 * time.Second
+const libraryTTL = 60 * time.Second
+const maxLibraryPages = 500
+const maxLibraryItems = 150000
+
+type libraryItem struct {
+	uri     string
+	addedAt int64
+}
+
+// Each authenticated AppPlayer owns its own service. The gate serializes reads
+// and writes off the player loop; slots bound pending calls. No collection
+// cache or captured session is shared across accounts.
+type libraryService struct {
+	username string
+	page     func(context.Context, *collectionpb.PageRequest) (*collectionpb.PageResponse, error)
+	write    func(context.Context, *collectionpb.WriteRequest) error
+	meta     *metaFetcher
+	now      func() time.Time
+	items    []libraryItem
+	fetched  time.Time
+	gate     chan struct{}
+	slots    chan struct{}
+}
+
+func newLibraryService(username string, sp *spclient.Spclient, log librespot.Logger) *libraryService {
+	// Playback caches transformed metadata after relinking: the alternative
+	// GID/files replace the originals, but their country restrictions remain.
+	// Keep raw metadata separately so browsing never interprets that mixed
+	// record as proof that a successfully playing song is unavailable.
+	meta := newMetaFetcher(log, newTrackMetaCache(), sp)
+	return &libraryService{username: username, page: sp.CollectionPage, write: sp.CollectionWrite,
+		meta: meta, now: time.Now, gate: make(chan struct{}, 1), slots: make(chan struct{}, 4)}
+}
+
+func validLibraryURI(uri string) bool {
+	if !strings.HasPrefix(uri, "spotify:track:") || len(uri) != len("spotify:track:")+22 {
+		return false
+	}
+	for _, c := range strings.TrimPrefix(uri, "spotify:track:") {
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9') {
+			return false
+		}
+	}
+	value, ok := new(big.Int).SetString(strings.TrimPrefix(uri, "spotify:track:"), 62)
+	return ok && value.BitLen() <= 128
+}
+
+func (s *libraryService) lock(ctx context.Context) error {
+	select {
+	case s.gate <- struct{}{}:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+func (s *libraryService) unlock() { <-s.gate }
+
+func (s *libraryService) snapshot(ctx context.Context, refresh bool) ([]libraryItem, error) {
+	if err := s.lock(ctx); err != nil {
+		return nil, err
+	}
+	defer s.unlock()
+	return s.snapshotLocked(ctx, refresh)
+}
+
+func (s *libraryService) snapshotLocked(ctx context.Context, refresh bool) ([]libraryItem, error) {
+	if !refresh && !s.fetched.IsZero() && s.now().Sub(s.fetched) < libraryTTL {
+		return s.items, nil
+	}
+	found := make(map[string]libraryItem)
+	token := ""
+	seen := make(map[string]bool)
+	count := 0
+	for pageNo := 0; pageNo < maxLibraryPages; pageNo++ {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		page, err := s.page(ctx, &collectionpb.PageRequest{Username: s.username, Set: "collection", PaginationToken: token, Limit: 300})
+		if err != nil {
+			return nil, fmt.Errorf("reading liked songs: %w", err)
+		}
+		if page == nil {
+			return nil, errors.New("Spotify returned an invalid collection page")
+		}
+		count += len(page.Items)
+		if count > maxLibraryItems {
+			return nil, errors.New("Spotify collection exceeded the item limit")
+		}
+		for _, item := range page.Items {
+			if item == nil || !validLibraryURI(item.Uri) {
+				continue
+			}
+			if item.IsRemoved {
+				delete(found, item.Uri)
+				continue
+			}
+			found[item.Uri] = libraryItem{uri: item.Uri, addedAt: item.AddedAt}
+		}
+		token = page.NextPageToken
+		if token == "" {
+			items := make([]libraryItem, 0, len(found))
+			for _, item := range found {
+				items = append(items, item)
+			}
+			sort.Slice(items, func(i, j int) bool {
+				if items[i].addedAt != items[j].addedAt {
+					return items[i].addedAt > items[j].addedAt
+				}
+				return items[i].uri < items[j].uri
+			})
+			s.items, s.fetched = items, s.now()
+			return items, nil
+		}
+		if len(token) > 16384 || seen[token] {
+			return nil, errors.New("Spotify returned an invalid collection cursor")
+		}
+		seen[token] = true
+	}
+	return nil, errors.New("Spotify collection exceeded the page limit")
+}
+
+func (s *libraryService) contains(ctx context.Context, uri string) (bool, error) {
+	if !validLibraryURI(uri) {
+		return false, ErrBadRequest
+	}
+	items, err := s.snapshot(ctx, false)
+	if err != nil {
+		return false, err
+	}
+	for _, item := range items {
+		if item.uri == uri {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+func (s *libraryService) setSaved(ctx context.Context, uri string, saved bool) error {
+	if !validLibraryURI(uri) {
+		return ErrBadRequest
+	}
+	if err := s.lock(ctx); err != nil {
+		return err
+	}
+	defer s.unlock()
+	// Re-read before writing so an idempotent save preserves the original added
+	// timestamp and does not move an existing like to the top of the library.
+	items, err := s.snapshotLocked(ctx, true)
+	if err != nil {
+		return err
+	}
+	var addedAt int64
+	if saved {
+		addedAt = s.now().Unix()
+		for _, item := range items {
+			if item.uri == uri {
+				addedAt = item.addedAt
+				break
+			}
+		}
+	}
+	updateID, err := uuid.NewRandom()
+	if err != nil {
+		return err
+	}
+	request := &collectionpb.WriteRequest{Username: s.username, Set: "collection",
+		ClientUpdateId: updateID.String(),
+		Items:          []*collectionpb.CollectionItem{{Uri: uri, AddedAt: addedAt, IsRemoved: !saved}}}
+	// Even a failed response can follow a successful remote write. Force a fresh
+	// read after any attempted mutation and never claim success on an error.
+	s.fetched = time.Time{}
+	if err := s.write(ctx, request); err != nil {
+		return fmt.Errorf("updating liked song: %w", err)
+	}
+	return nil
+}
+
+func libraryTrackPlayable(track *metadatapb.Track, country string) bool {
+	candidates := append([]*metadatapb.Track{track}, track.GetAlternative()...)
+	for _, candidate := range candidates {
+		// Audio files are resolved by the player through AUDIO_FILES, separately
+		// from TRACK_V4. An empty legacy File list does not forbid playback.
+		if candidate == nil {
+			continue
+		}
+		restricted := false
+		if len(country) == 2 {
+			for _, restriction := range candidate.Restriction {
+				if restriction == nil {
+					continue
+				}
+				contains := func(countries string) bool {
+					for i := 0; i+1 < len(countries); i += 2 {
+						if strings.EqualFold(countries[i:i+2], country) {
+							return true
+						}
+					}
+					return false
+				}
+				switch r := restriction.CountryRestriction.(type) {
+				case *metadatapb.Restriction_CountriesAllowed:
+					restricted = !contains(r.CountriesAllowed)
+				case *metadatapb.Restriction_CountriesForbidden:
+					restricted = contains(r.CountriesForbidden)
+				}
+				if restricted {
+					break
+				}
+			}
+		}
+		if !restricted {
+			return true
+		}
+	}
+	return false
+}
+
+func (s *libraryService) tracks(ctx context.Context, offset, limit int, refresh bool, country string) (*ApiLibraryTracks, error) {
+	if offset < 0 || limit < 1 || limit > 100 {
+		return nil, ErrBadRequest
+	}
+	items, err := s.snapshot(ctx, refresh)
+	if err != nil {
+		return nil, err
+	}
+	response := &ApiLibraryTracks{Items: make([]ApiLibraryTrack, 0), Offset: offset, Limit: limit, Total: len(items)}
+	if offset >= len(items) {
+		return response, nil
+	}
+	end := offset + min(limit, len(items)-offset)
+	response.HasNext = end < len(items)
+	uris := make([]string, 0, end-offset)
+	for _, item := range items[offset:end] {
+		uris = append(uris, item.uri)
+	}
+	missing := s.meta.cache.missing(uris)
+	if len(missing) > 0 {
+		if _, err := s.meta.fetchBatch(ctx, missing); err != nil {
+			return nil, fmt.Errorf("reading liked-song metadata: %w", err)
+		}
+	}
+	for _, uri := range uris {
+		entry := ApiLibraryTrack{Uri: uri, Name: "Unavailable track", ArtistNames: []string{}}
+		if media := s.meta.cache.get(uri); media != nil && media.IsTrack() {
+			track := media.Track()
+			if track.GetName() != "" {
+				entry.Name = track.GetName()
+			}
+			entry.AlbumName = track.GetAlbum().GetName()
+			entry.Duration = int(track.GetDuration())
+			for _, artist := range track.Artist {
+				if artist.GetName() != "" {
+					entry.ArtistNames = append(entry.ArtistNames, artist.GetName())
+				}
+			}
+			entry.Playable = libraryTrackPlayable(track, country)
+		}
+		response.Items = append(response.Items, entry)
+	}
+	return response, nil
+}
+
+func (p *AppPlayer) handleLibraryRequest(req ApiRequest) (any, error) {
+	username := p.sess.Username()
+	var expected string
+	switch data := req.Data.(type) {
+	case GetLibraryTracksParams:
+		if data.Username != nil {
+			expected = *data.Username
+		}
+	case GetLibraryContainsParams:
+		expected = data.Username
+	case ApiLibrarySave:
+		expected = data.Username
+	}
+	if expected != "" && expected != username {
+		return nil, ErrConflictAccount
+	}
+	if req.Type == ApiRequestTypeLibrarySave && expected == "" {
+		return nil, ErrBadRequest
+	}
+	if p.library == nil {
+		p.library = newLibraryService(username, p.sess.Spclient(), p.app.log)
+	}
+	service := p.library
+	select {
+	case service.slots <- struct{}{}:
+	default:
+		return nil, ErrTooManyRequests
+	}
+	reply := apiReply(req)
+	country := p.CountryCode()
+	p.goDetached(libraryTimeout, func(ctx context.Context) {
+		defer func() { <-service.slots }()
+		var result any
+		var err error
+		switch req.Type {
+		case ApiRequestTypeLibraryTracks:
+			data := req.Data.(GetLibraryTracksParams)
+			offset, limit, refresh := 0, 20, false
+			if data.Offset != nil {
+				offset = *data.Offset
+			}
+			if data.Limit != nil {
+				limit = *data.Limit
+			}
+			if data.Refresh != nil {
+				refresh = *data.Refresh
+			}
+			result, err = service.tracks(ctx, offset, limit, refresh, country)
+		case ApiRequestTypeLibraryContains:
+			data := req.Data.(GetLibraryContainsParams)
+			var saved bool
+			saved, err = service.contains(ctx, data.Uri)
+			result = &ApiLibrarySaved{Saved: saved}
+		case ApiRequestTypeLibrarySave:
+			data := req.Data.(ApiLibrarySave)
+			err = service.setSaved(ctx, data.Uri, data.Saved)
+			result = &ApiLibrarySaved{Saved: data.Saved}
+		}
+		reply.done(result, err)
+	})
+	return nil, errReplyDeferred
+}
