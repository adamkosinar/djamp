+	if err := jsonDecode(r, &payload); err != nil || !validLibraryURI(payload.Uri) || payload.Username == "" || payload.Saved == nil {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	data := ApiLibrarySave{Uri: payload.Uri, Saved: *payload.Saved, Username: payload.Username}
+	s.handleRequest(ApiRequest{Type: ApiRequestTypeLibrarySave, Data: data}, w)
+}
