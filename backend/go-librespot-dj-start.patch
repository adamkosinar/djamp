+package daemon
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/stretchr/testify/require"
+)
+
+func TestLibrarySaveRejectsMissingOrInvalidFields(t *testing.T) {
+	uri := "spotify:track:0000000000000000000001"
+	for _, body := range []string{
+		`{}`, `{"uri":"` + uri + `","username":"account"}`,
+		`{"uri":"` + uri + `","username":"account","saved":null}`,
+		`{"uri":"` + uri + `","username":"account","saved":"false"}`,
+		`{"uri":"` + uri + `","saved":false}`,
+		`{"uri":"spotify:track:zzzzzzzzzzzzzzzzzzzzzz","username":"account","saved":false}`,
+		`{"uri":"spotify:album:0000000000000000000001","username":"account","saved":true}`,
+	} {
+		s := &ConcreteApiServer{requests: make(chan ApiRequest, 1)}
+		recorder := httptest.NewRecorder()
+		s.SaveLibraryTrack(recorder, httptest.NewRequest(http.MethodPost, "/library/save", strings.NewReader(body)))
+		require.Equal(t, http.StatusBadRequest, recorder.Code)
+		require.Empty(t, s.requests, "invalid payload must not reach player or mutate the library")
+	}
+}
+func TestLibraryRoutesPreserveExplicitFalseAndAccount(t *testing.T) {
+	cases := []struct {
+		method, path, body string
+		kind               ApiRequestType
+	}{
+		{"POST", "/library/save", `{"uri":"spotify:track:0000000000000000000001","username":"account","saved":false}`, ApiRequestTypeLibrarySave},
+		{"GET", "/library/contains?uri=spotify:track:0000000000000000000001&username=account", "", ApiRequestTypeLibraryContains},
+		{"GET", "/library/tracks?offset=20&limit=20&username=account&refresh=true", "", ApiRequestTypeLibraryTracks},
+	}
+	for _, tc := range cases {
+		t.Run(string(tc.kind), func(t *testing.T) {
+			s := &ConcreteApiServer{log: &librespot.NullLogger{}, requests: make(chan ApiRequest, 1)}
+			received := make(chan ApiRequest, 1)
+			go func() { req := <-s.requests; received <- req; req.Reply(&ApiLibrarySaved{Saved: false}, nil) }()
+			recorder := httptest.NewRecorder()
+			Handler(s).ServeHTTP(recorder, httptest.NewRequest(tc.method, tc.path, strings.NewReader(tc.body)))
+			require.Equal(t, http.StatusOK, recorder.Code)
+			req := <-received
+			require.Equal(t, tc.kind, req.Type)
+			switch data := req.Data.(type) {
+			case ApiLibrarySave:
+				require.False(t, data.Saved)
+				require.Equal(t, "account", data.Username)
+			case GetLibraryContainsParams:
+				require.Equal(t, "account", data.Username)
+			case GetLibraryTracksParams:
+				require.Equal(t, "account", *data.Username)
+				require.Equal(t, 20, *data.Offset)
+				require.True(t, *data.Refresh)
+			default:
+				t.Fatalf("unexpected payload type %T", data)
+			}
+		})
+	}
+}
+func TestLibraryResponseJSONHasStableEmptyArraysAndCapability(t *testing.T) {
+	page := ApiLibraryTracks{Items: []ApiLibraryTrack{}, Limit: 20}
+	raw, err := json.Marshal(page)
+	require.NoError(t, err)
+	require.JSONEq(t, `{"items":[],"offset":0,"limit":20,"total":0,"has_next":false}`, string(raw))
+	raw, err = json.Marshal(ApiRoot{Library: true, DirectDj: true})
+	require.NoError(t, err)
+	require.JSONEq(t, `{"library":true,"direct_dj":true,"playback_ready":false}`, string(raw))
+}
