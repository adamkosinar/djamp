diff --git a/daemon/api_requested_uri_test.go b/daemon/api_requested_uri_test.go
new file mode 100644
index 0000000..89a2966
--- /dev/null
+++ b/daemon/api_requested_uri_test.go
@@ -0,0 +1,73 @@
+//go:build test_unit
+
+package daemon
+
+import (
+	"encoding/json"
+	"testing"
+
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/player"
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+	"github.com/stretchr/testify/require"
+)
+
+func TestApiTrackPreservesRequestedURIThroughRelinking(t *testing.T) {
+	original := librespot.SpotifyIdFromGid(librespot.SpotifyIdTypeTrack, gid(1))
+	alternative := librespot.SpotifyIdFromGid(librespot.SpotifyIdTypeTrack, gid(2))
+	p := &AppPlayer{app: &App{cfg: &Config{}}, prodInfo: &ProductInfo{}}
+
+	for _, tc := range []struct {
+		name      string
+		requested librespot.SpotifyId
+		playable  librespot.SpotifyId
+		want      string
+	}{
+		{"relinked", original, alternative, original.Uri()},
+		{"ordinary", original, original, original.Uri()},
+		{"unknown request falls back to media", librespot.SpotifyId{}, alternative, alternative.Uri()},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			stream := &player.Stream{
+				RequestedId: tc.requested,
+				Media:       librespot.NewMediaFromTrack(metaTrack(tc.playable.Id(), "Song")),
+			}
+			// /status and metadata events use this same constructor. Preserve
+			// the existing playable URI while exposing the library identity.
+			track := p.newApiResponseStatusTrack(stream, 123)
+			require.Equal(t, tc.playable.Uri(), track.Uri)
+			require.Equal(t, tc.want, track.RequestedUri)
+			require.EqualValues(t, 123, track.Position)
+
+			raw, err := json.Marshal(ApiEvent{Type: ApiEventTypeMetadata, Data: ApiEventDataMetadata(*track)})
+			require.NoError(t, err)
+			var event struct {
+				Data struct {
+					Uri          string `json:"uri"`
+					RequestedUri string `json:"requested_uri"`
+				} `json:"data"`
+			}
+			require.NoError(t, json.Unmarshal(raw, &event))
+			require.Equal(t, tc.playable.Uri(), event.Data.Uri)
+			require.Equal(t, tc.want, event.Data.RequestedUri)
+		})
+	}
+}
+
+func TestApiCachedTracksKeepTheirContextURIForLibraryOperations(t *testing.T) {
+	original, alternative := trackUri(1), trackUri(2)
+	p := newMetaTestPlayer(t, nil, nil)
+	p.app.metaCache.put(original, librespot.NewMediaFromTrack(metaTrack(gid(2), "Relinked song")))
+	p.state.player.NextTracks = []*connectpb.ProvidedTrack{provided(original)}
+
+	next := p.apiNextTrack()
+	require.NotNil(t, next)
+	require.Equal(t, alternative, next.Uri)
+	require.Equal(t, original, next.RequestedUri)
+
+	listing := p.contextTracksResponse("spotify:user:account:collection", []string{original}, true)
+	require.Len(t, listing.Tracks, 1)
+	require.Equal(t, original, listing.Tracks[0].Uri)
+	require.Equal(t, alternative, listing.Tracks[0].Track.Uri)
+	require.Equal(t, original, listing.Tracks[0].Track.RequestedUri)
+}
