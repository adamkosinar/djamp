+func TestLibraryFailedPrewriteReadNeverMutates(t *testing.T) {
+	service, now := libraryFixture(t)
+	service.items, service.fetched = []libraryItem{{uri: libraryTestURI(1), addedAt: 99}}, *now
+	failure := errors.New("cannot establish current saved state")
+	service.page = func(context.Context, *collectionpb.PageRequest) (*collectionpb.PageResponse, error) {
+		return nil, failure
+	}
+	if err := service.setSaved(context.Background(), libraryTestURI(1), true); !errors.Is(err, failure) {
+		t.Fatalf("expected scan error, got %v", err)
+	}
+	// The fixture's write function fails the test if called.
+}
+
+func TestLibraryRejectsInvalidTrackURIsBeforeNetwork(t *testing.T) {
+	for _, uri := range []string{"", "spotify:track:bad", "https://open.spotify.com/track/" + strings.Repeat("0", 22),
+		"spotify:episode:" + strings.Repeat("0", 22), "spotify:local:artist:album:song:123",
+		"spotify:track:" + strings.Repeat("_", 22), "spotify:track:" + strings.Repeat("0", 23),
+		"spotify:track:" + strings.Repeat("z", 22), "spotify:track:" + strings.Repeat("Z", 22)} {
+		t.Run(uri, func(t *testing.T) {
+			service, _ := libraryFixture(t)
+			if saved, err := service.contains(context.Background(), uri); saved || !errors.Is(err, ErrBadRequest) {
+				t.Fatalf("invalid contains: %v %v", saved, err)
+			}
+			for _, save := range []bool{false, true} {
+				if err := service.setSaved(context.Background(), uri, save); !errors.Is(err, ErrBadRequest) {
+					t.Fatalf("invalid save: %v", err)
+				}
+			}
+		})
+	}
+}
+
+func TestLibraryCanceledCallerDoesNotWaitForBusyGate(t *testing.T) {
+	service, _ := libraryFixture(t)
+	service.gate <- struct{}{}
+	defer func() { <-service.gate }()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := service.snapshot(ctx, false); !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancellation lost: %v", err)
+	}
+	if err := service.setSaved(ctx, libraryTestURI(1), true); !errors.Is(err, context.Canceled) {
+		t.Fatalf("mutation cancellation lost: %v", err)
+	}
+}
