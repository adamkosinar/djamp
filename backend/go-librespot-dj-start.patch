+
+func TestLibraryAmbiguousWriteFailureForcesFreshRead(t *testing.T) {
+	service, _ := libraryFixture(t)
+	failure := errors.New("response lost after write")
+	applied := false
+	reads := 0
+	service.page = func(context.Context, *collectionpb.PageRequest) (*collectionpb.PageResponse, error) {
+		reads++
+		response := &collectionpb.PageResponse{}
+		if applied {
+			response.Items = []*collectionpb.CollectionItem{{Uri: libraryTestURI(1), AddedAt: 77}}
+		}
+		return response, nil
+	}
+	service.write = func(context.Context, *collectionpb.WriteRequest) error { applied = true; return failure }
+	if err := service.setSaved(context.Background(), libraryTestURI(1), true); !errors.Is(err, failure) {
+		t.Fatalf("write error lost: %v", err)
+	}
+	if !service.fetched.IsZero() {
+		t.Fatal("ambiguous write kept authoritative cache")
