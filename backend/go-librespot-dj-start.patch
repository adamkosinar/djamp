+++ b/daemon/playback_recovery_test.go
@@ -0,0 +1,292 @@
+//go:build test_unit
+
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
