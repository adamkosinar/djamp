+			require.False(t, p.recoverySelecting)
+			require.Equal(t, want, p.state.player.Track.Uri)
+			require.Equal(t, want, p.apiPlaybackError().Uri)
+			require.Nil(t, p.app.djCursor("test-account"))
+			expireAudioCooldown(p.loader)
+			require.NoError(t, p.play())
+			require.Len(t, p.loader.queue, 1)
+			require.Equal(t, "load "+want, p.loader.queue[0].name)
