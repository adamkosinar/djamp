+	"github.com/stretchr/testify/require"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/anypb"
+)
+
+func TestLibraryPlayableDoesNotRequireLegacyTrackFiles(t *testing.T) {
+	allowed := func(countries string) []*metadatapb.Restriction {
+		return []*metadatapb.Restriction{{CountryRestriction: &metadatapb.Restriction_CountriesAllowed{CountriesAllowed: countries}}}
+	}
+	for _, tc := range []struct {
+		name     string
+		track    *metadatapb.Track
+		playable bool
+	}{
+		{"unrestricted metadata without files", &metadatapb.Track{}, true},
+		{"allowed metadata without files", &metadatapb.Track{Restriction: allowed("CZUS")}, true},
+		{"allowed alternative without files", &metadatapb.Track{
+			Restriction: allowed("US"),
+			Alternative: []*metadatapb.Track{nil, {Restriction: allowed("CZ")}},
+		}, true},
+		{"all candidates restricted", &metadatapb.Track{
+			Restriction: allowed("US"),
+			Alternative: []*metadatapb.Track{{Restriction: allowed("GB")}},
+		}, false},
+		{"missing track", nil, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			// Playback resolves audio separately through AUDIO_FILES; TRACK_V4
+			// does not have to include the legacy file list.
+			require.Equal(t, tc.playable, libraryTrackPlayable(tc.track, "CZ"))
+		})
+	}
+}
+
+func TestLibraryFetchesRawMetadataAfterPlaybackRelinking(t *testing.T) {
+	uri := libraryTestURI(1)
+	id, err := librespot.SpotifyIdFromUri(uri)
+	require.NoError(t, err)
+	altID, err := librespot.SpotifyIdFromUri(libraryTestURI(2))
+	require.NoError(t, err)
+	alternative := &metadatapb.Track{
+		Gid:         altID.Id(),
+		File:        []*metadatapb.AudioFile{{Format: metadatapb.AudioFile_OGG_VORBIS_160.Enum()}},
+		Restriction: []*metadatapb.Restriction{{CountryRestriction: &metadatapb.Restriction_CountriesAllowed{CountriesAllowed: "CZ"}}},
+	}
+	raw := &metadatapb.Track{
+		Gid:         id.Id(),
+		Name:        proto.String("Playable through an alternative"),
+		Restriction: []*metadatapb.Restriction{{CountryRestriction: &metadatapb.Restriction_CountriesAllowed{CountriesAllowed: "US"}}},
+		Alternative: []*metadatapb.Track{alternative},
+	}
+	// getUnrestrictedTrack preserves the original restrictions while copying
+	// the chosen alternative's audio and clearing the alternatives. The player
+	// then caches that transformed track under the originally requested URI.
+	relinked := proto.Clone(raw).(*metadatapb.Track)
+	relinked.Alternative = nil
+	relinked.Gid = alternative.Gid
+	relinked.File = alternative.File
+	relinked.Preview = alternative.Preview
+	relinked.OriginalAudio = alternative.OriginalAudio
+	playbackCache := newTrackMetaCache()
+	playbackCache.putStream(uri, librespot.NewMediaFromTrack(relinked))
+	require.False(t, libraryTrackPlayable(playbackCache.get(uri).Track(), "CZ"), "the playback cache cannot establish the original track's availability")
+
+	service := newLibraryService("test-account", nil, &librespot.NullLogger{})
+	service.page = func(context.Context, *collectionpb.PageRequest) (*collectionpb.PageResponse, error) {
+		return &collectionpb.PageResponse{Items: []*collectionpb.CollectionItem{{Uri: uri}}}, nil
+	}
+	metadataCalls := 0
+	service.meta.fetch = func(_ context.Context, req *extmetadatapb.BatchedEntityRequest) (*extmetadatapb.BatchedExtensionResponse, error) {
+		metadataCalls++
+		require.Len(t, req.EntityRequest, 1)
+		require.Equal(t, uri, req.EntityRequest[0].EntityUri)
+		payload, err := anypb.New(raw)
+		require.NoError(t, err)
+		return &extmetadatapb.BatchedExtensionResponse{ExtendedMetadata: []*extmetadatapb.EntityExtensionDataArray{{
+			ExtensionKind: extmetadatapb.ExtensionKind_TRACK_V4,
+			ExtensionData: []*extmetadatapb.EntityExtensionData{{
+				Header: &extmetadatapb.EntityExtensionDataHeader{StatusCode: 200}, EntityUri: uri, ExtensionData: payload,
+			}},
+		}}}, nil
+	}
+	page, err := service.tracks(context.Background(), 0, 20, false, "CZ")
+	require.NoError(t, err)
+	require.Equal(t, 1, metadataCalls)
+	require.Len(t, page.Items, 1)
+	require.True(t, page.Items[0].Playable)
+	require.Equal(t, uri, page.Items[0].Uri)
+	require.True(t, proto.Equal(raw, service.meta.cache.get(uri).Track()))
+	require.True(t, proto.Equal(relinked, playbackCache.get(uri).Track()), "the library must not replace playback metadata")
+}
diff --git a/daemon/library_test.go b/daemon/library_test.go
