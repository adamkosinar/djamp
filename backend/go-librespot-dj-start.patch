+func TestDJThreeLaunchesUseConsecutiveServerSets(t *testing.T) {
+	r := newDJSequence()
+	var saved *librespot.DJCursor
+	var originalRoot string
+	for launch := 0; launch < 3; launch++ {
+		resolved, root, err := resolveDJStart(t.Context(), r, djContextURI, saved)
+		require.NoError(t, err)
+		if launch == 0 {
+			originalRoot = root
+		}
+		require.Equal(t, originalRoot, root)
+		require.True(t, r.deadline)
+		require.Equal(t, fmt.Sprintf("spotify:track:track%d", launch), resolved.Pages[0].Tracks[0].Uri)
+		require.Equal(t, "server intro", resolved.Pages[0].Tracks[0].Metadata["narration.intro.ssml"])
+		require.Equal(t, r.root.Metadata, resolved.Metadata)
+		require.True(t, proto.Equal(r.root.Restrictions, resolved.Restrictions))
+		// The owner records this only after the returned page starts playing.
+		saved = &librespot.DJCursor{RootFingerprint: root, NextPageURL: resolved.Pages[0].NextPageUrl}
+	}
+	require.Equal(t, []string{djPageURL(1), djPageURL(2)}, r.requested)
+	require.Equal(t, "spotify:track:track0", r.root.Pages[0].Tracks[0].Uri, "do not mutate the root while selecting a later page")
