+package spclient
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+
+	collectionpb "github.com/devgianlu/go-librespot/proto/spotify/collection/v2"
+	"google.golang.org/protobuf/proto"
+)
+
+const collectionContentType = "application/vnd.collection-v2.spotify.proto"
+const maxCollectionResponse = 4 << 20
+
+func (c *Spclient) collectionRequest(ctx context.Context, path string, request proto.Message) ([]byte, error) {
+	body, err := proto.Marshal(request)
+	if err != nil {
+		return nil, fmt.Errorf("encoding collection request: %w", err)
+	}
+	resp, err := c.Request(ctx, http.MethodPost, path, nil, http.Header{
+		"Content-Type": {collectionContentType}, "Accept": {collectionContentType},
+	}, body)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 || path == "/collection/v2/paging" && resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("Spotify collection request failed (HTTP %d)", resp.StatusCode)
+	}
+	raw, err := io.ReadAll(io.LimitReader(resp.Body, maxCollectionResponse+1))
+	if err != nil {
+		return nil, fmt.Errorf("reading collection response: %w", err)
+	}
+	if len(raw) > maxCollectionResponse {
+		return nil, fmt.Errorf("Spotify collection response exceeded the size limit")
+	}
+	return raw, nil
+}
+
+func (c *Spclient) CollectionPage(ctx context.Context, request *collectionpb.PageRequest) (*collectionpb.PageResponse, error) {
+	raw, err := c.collectionRequest(ctx, "/collection/v2/paging", request)
+	if err != nil {
+		return nil, err
+	}
+	var result collectionpb.PageResponse
+	if err := proto.Unmarshal(raw, &result); err != nil {
+		return nil, fmt.Errorf("decoding collection response: %w", err)
+	}
+	return &result, nil
+}
+
+func (c *Spclient) CollectionWrite(ctx context.Context, request *collectionpb.WriteRequest) error {
+	_, err := c.collectionRequest(ctx, "/collection/v2/write", request)
+	return err
+}
