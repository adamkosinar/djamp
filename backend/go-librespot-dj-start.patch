+
+func TestLibrarySaveWireFieldsAndExistingTimestamp(t *testing.T) {
+	service, now := libraryFixture(t)
+	reads := 0
+	service.page = func(context.Context, *collectionpb.PageRequest) (*collectionpb.PageResponse, error) {
+		reads++
+		return &collectionpb.PageResponse{Items: []*collectionpb.CollectionItem{{Uri: libraryTestURI(1), AddedAt: 1234}}}, nil
+	}
+	var writes []*collectionpb.WriteRequest
+	service.write = func(_ context.Context, request *collectionpb.WriteRequest) error {
+		writes = append(writes, request)
+		return nil
+	}
+	for _, change := range []struct {
+		uri   string
+		saved bool
+	}{
+		{libraryTestURI(2), true}, {libraryTestURI(1), true}, {libraryTestURI(1), false},
+	} {
+		if err := service.setSaved(context.Background(), change.uri, change.saved); err != nil {
+			t.Fatal(err)
+		}
+		if !service.fetched.IsZero() {
+			t.Fatal("write did not invalidate collection cache")
+		}
+	}
+	if reads != 3 || len(writes) != 3 {
+		t.Fatalf("reads=%d writes=%d, want three each", reads, len(writes))
+	}
+	ids := make(map[string]bool)
+	for index, request := range writes {
+		if request.Username != "test-user" || request.Set != "collection" || len(request.Items) != 1 {
+			t.Fatalf("write routing/arity wrong: %#v", request)
+		}
+		id, err := uuid.Parse(request.ClientUpdateId)
+		if err != nil || id.Version() != 4 || id.Variant() != uuid.RFC4122 || ids[request.ClientUpdateId] {
+			t.Fatal("mutation ID missing or reused")
+		}
+		ids[request.ClientUpdateId] = true
+		item := request.Items[0]
+		wantURI := libraryTestURI(1)
+		wantAddedAt := int64(1234)
+		if index == 0 {
