+package daemon
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	collectionpb "github.com/devgianlu/go-librespot/proto/spotify/collection/v2"
+	"github.com/google/uuid"
+)
+
+func libraryTestURI(number int) string {
+	return fmt.Sprintf("spotify:track:%022d", number)
+}
+
+func libraryFixture(t *testing.T) (*libraryService, *time.Time) {
+	t.Helper()
+	now := time.Unix(10000, 0)
+	service := &libraryService{
+		username: "test-user", now: func() time.Time { return now },
+		gate: make(chan struct{}, 1), slots: make(chan struct{}, 4),
+		page: func(context.Context, *collectionpb.PageRequest) (*collectionpb.PageResponse, error) {
+			t.Error("unexpected collection read")
+			return nil, errors.New("unexpected read")
+		},
+		write: func(context.Context, *collectionpb.WriteRequest) error {
+			t.Error("unexpected collection write")
+			return errors.New("unexpected write")
+		},
+	}
+	return service, &now
+}
+
+func TestLibrarySnapshotPagesFilterTombstonesAndSort(t *testing.T) {
+	service, now := libraryFixture(t)
+	pages := []*collectionpb.PageResponse{
+		{Items: []*collectionpb.CollectionItem{
+			{Uri: libraryTestURI(1), AddedAt: 10},
+			{Uri: libraryTestURI(2), AddedAt: 20},
+			{Uri: "spotify:album:" + strings.Repeat("0", 22), AddedAt: 90},
+			{Uri: "spotify:episode:" + strings.Repeat("0", 22), AddedAt: 80},
+			{Uri: "spotify:local:artist:album:song:123", AddedAt: 70},
+			{Uri: "spotify:track:bad", AddedAt: 60}, nil,
+		}, NextPageToken: "second"},
+		{Items: []*collectionpb.CollectionItem{
+			{Uri: libraryTestURI(1), IsRemoved: true},
+			{Uri: libraryTestURI(2), AddedAt: 25},
+			{Uri: libraryTestURI(4), AddedAt: 30},
+		}, NextPageToken: "third"},
+		{Items: []*collectionpb.CollectionItem{
+			{Uri: libraryTestURI(3), AddedAt: 30},
+			{Uri: libraryTestURI(9), IsRemoved: true},
+		}},
+	}
+	var tokens []string
+	service.page = func(_ context.Context, request *collectionpb.PageRequest) (*collectionpb.PageResponse, error) {
+		if request.Username != "test-user" || request.Set != "collection" || request.Limit != 300 {
+			t.Errorf("incorrect collection request: %#v", request)
+		}
+		index := len(tokens)
+		tokens = append(tokens, request.PaginationToken)
+		if index >= len(pages) {
+			t.Fatal("unexpected extra page")
+		}
+		return pages[index], nil
+	}
+	got, err := service.snapshot(context.Background(), false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []libraryItem{{uri: libraryTestURI(3), addedAt: 30}, {uri: libraryTestURI(4), addedAt: 30}, {uri: libraryTestURI(2), addedAt: 25}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %#v, want %#v", got, want)
+	}
+	if !reflect.DeepEqual(tokens, []string{"", "second", "third"}) {
+		t.Fatalf("wrong page tokens: %#v", tokens)
+	}
+	if !service.fetched.Equal(*now) {
+		t.Fatal("complete scan was not cached")
+	}
+}
+
+func TestLibrarySnapshotCachesForSixtySecondsAndSupportsRefresh(t *testing.T) {
+	service, now := libraryFixture(t)
+	calls := 0
+	service.page = func(context.Context, *collectionpb.PageRequest) (*collectionpb.PageResponse, error) {
+		calls++
+		return &collectionpb.PageResponse{Items: []*collectionpb.CollectionItem{{Uri: libraryTestURI(calls)}}}, nil
+	}
+	get := func(refresh bool, expectedCalls int) {
+		t.Helper()
+		if _, err := service.snapshot(context.Background(), refresh); err != nil {
+			t.Fatal(err)
+		}
+		if calls != expectedCalls {
+			t.Fatalf("read count %d, want %d", calls, expectedCalls)
+		}
+	}
+	get(false, 1)
+	*now = now.Add(59 * time.Second)
+	get(false, 1)
+	*now = now.Add(time.Second)
+	get(false, 2)
+	get(true, 3)
+	get(false, 3)
+}
+
+func TestLibraryEmptySnapshotContainsAndFirstSave(t *testing.T) {
+	service, _ := libraryFixture(t)
+	reads, writes := 0, 0
+	service.page = func(context.Context, *collectionpb.PageRequest) (*collectionpb.PageResponse, error) {
+		reads++
+		return &collectionpb.PageResponse{}, nil
+	}
+	service.write = func(_ context.Context, request *collectionpb.WriteRequest) error {
+		writes++
+		if len(request.Items) != 1 || request.Items[0].Uri != libraryTestURI(1) || request.Items[0].IsRemoved {
+			t.Fatalf("incorrect first save: %#v", request)
+		}
+		return nil
+	}
+	items, err := service.snapshot(context.Background(), false)
+	if err != nil || len(items) != 0 || service.fetched.IsZero() {
+		t.Fatalf("empty collection not complete: %#v %v", items, err)
+	}
+	saved, err := service.contains(context.Background(), libraryTestURI(1))
+	if saved || err != nil || reads != 1 {
+		t.Fatalf("empty contains: saved=%v err=%v reads=%d", saved, err, reads)
+	}
+	if err := service.setSaved(context.Background(), libraryTestURI(1), true); err != nil {
+		t.Fatal(err)
+	}
+	if writes != 1 || reads != 2 || !service.fetched.IsZero() {
+		t.Fatal("first save did not re-read and invalidate")
+	}
+}
+
+func TestLibraryPartialReadFailureNeverPublishesPartialCollection(t *testing.T) {
+	service, now := libraryFixture(t)
+	old := []libraryItem{{uri: libraryTestURI(1), addedAt: 1}}
+	service.items = old
+	service.fetched = now.Add(-libraryTTL)
+	oldFetched := service.fetched
+	failure := errors.New("page failed")
+	service.page = func(_ context.Context, request *collectionpb.PageRequest) (*collectionpb.PageResponse, error) {
+		if request.PaginationToken == "" {
+			return &collectionpb.PageResponse{Items: []*collectionpb.CollectionItem{{Uri: libraryTestURI(2), AddedAt: 2}}, NextPageToken: "next"}, nil
+		}
+		return nil, failure
+	}
+	items, err := service.snapshot(context.Background(), false)
+	if items != nil || !errors.Is(err, failure) {
+		t.Fatalf("partial read returned %#v, %v", items, err)
+	}
+	if !reflect.DeepEqual(service.items, old) || !service.fetched.Equal(oldFetched) {
+		t.Fatal("failed page published partial cache")
+	}
+	// Even finding the requested URI on an early page cannot establish the
+	// final saved state: a later page could contain its tombstone.
+	saved, err := service.contains(context.Background(), libraryTestURI(2))
+	if saved || !errors.Is(err, failure) {
+		t.Fatalf("contains suppressed scan failure: saved=%v err=%v", saved, err)
+	}
+	service.page = func(context.Context, *collectionpb.PageRequest) (*collectionpb.PageResponse, error) {
+		return &collectionpb.PageResponse{Items: []*collectionpb.CollectionItem{{Uri: libraryTestURI(3), AddedAt: 3}}}, nil
+	}
+	items, err = service.snapshot(context.Background(), false)
+	if err != nil || len(items) != 1 || items[0].uri != libraryTestURI(3) {
+		t.Fatalf("retry did not replace stale cache: %#v %v", items, err)
+	}
+}
+
+func TestLibrarySnapshotRejectsCyclesMalformedPagesAndBounds(t *testing.T) {
+	tests := []struct {
+		name  string
+		page  func(int) *collectionpb.PageResponse
+		calls int
+	}{
+		{"cycle", func(int) *collectionpb.PageResponse { return &collectionpb.PageResponse{NextPageToken: "same"} }, 2},
+		{"long cursor", func(int) *collectionpb.PageResponse {
+			return &collectionpb.PageResponse{NextPageToken: strings.Repeat("x", 16385)}
+		}, 1},
+		{"nil page", func(int) *collectionpb.PageResponse { return nil }, 1},
+		{"page limit", func(index int) *collectionpb.PageResponse {
+			return &collectionpb.PageResponse{NextPageToken: fmt.Sprint(index)}
+		}, maxLibraryPages},
+		{"raw item limit", func(int) *collectionpb.PageResponse {
+			return &collectionpb.PageResponse{Items: make([]*collectionpb.CollectionItem, maxLibraryItems+1)}
+		}, 1},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			service, _ := libraryFixture(t)
+			calls := 0
+			service.page = func(context.Context, *collectionpb.PageRequest) (*collectionpb.PageResponse, error) {
+				calls++
+				return test.page(calls), nil
+			}
+			items, err := service.snapshot(context.Background(), false)
+			if err == nil || items != nil || !service.fetched.IsZero() {
