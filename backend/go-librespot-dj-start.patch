+
+func TestFileStateStorePreservesCredentialsAndDJCursor(t *testing.T) {
+	dir := t.TempDir()
+	statePath := filepath.Join(dir, "state.json")
+	store := NewFileStateStore(statePath, "", &librespot.NullLogger{})
+	state := &librespot.AppState{DeviceId: "device-1", DJCursors: map[string]librespot.DJCursor{
+		"account-a": {RootFingerprint: "first-root", NextPageURL: "first-page"},
+		"account-b": {RootFingerprint: "other-root", NextPageURL: "other-page"},
+	}}
+	state.Credentials.Username = "account-a"
+	state.Credentials.Data = []byte("test-credential")
+	volume := uint32(30)
+	state.LastVolume = &volume
+	require.NoError(t, store.Save(state))
+	state.DJCursors["account-a"] = librespot.DJCursor{RootFingerprint: "first-root", NextPageURL: "next-page"}
+	require.NoError(t, store.Save(state))
+	loaded, err := store.Load()
+	require.NoError(t, err)
+	require.Equal(t, state.DJCursors, loaded.DJCursors)
+	require.Equal(t, state.Credentials, loaded.Credentials)
+	require.Equal(t, state.DeviceId, loaded.DeviceId)
+	require.Equal(t, state.LastVolume, loaded.LastVolume)
+	info, err := os.Stat(statePath)
+	require.NoError(t, err)
+	require.Zero(t, info.Mode().Perm()&0077, "cursor and credentials must remain private")
+	entries, err := os.ReadDir(dir)
+	require.NoError(t, err)
+	require.Len(t, entries, 1, "atomic saves should leave no temporary files")
+}
