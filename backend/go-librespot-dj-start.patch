diff --git a/tracks/dj_cursor_test.go b/tracks/dj_cursor_test.go
new file mode 100644
index 0000000..5ecec85
--- /dev/null
+++ b/tracks/dj_cursor_test.go
@@ -0,0 +1,162 @@
+//go:build test_unit
+
+package tracks
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"testing"
+
+	librespot "github.com/devgianlu/go-librespot"
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+)
+
+// Each page models one five-track DJ set. The first song recurs in every set,
+// so its URI alone cannot identify the page that the listener has reached.
+type djCursorResolver struct {
+	pages    [][]*connectpb.ContextTrack
+	loaded   map[int]bool
+	furthest int
+}
+
+func newDJCursorResolver() *djCursorResolver {
+	r := &djCursorResolver{loaded: make(map[int]bool), furthest: -1}
+	for page := range 12 {
+		var tracks []*connectpb.ContextTrack
+		for item := range 5 {
+			id := page*5 + item + 1
+			if item == 0 {
+				id = 1
+			}
+			tracks = append(tracks, &connectpb.ContextTrack{
+				Uri: fmt.Sprintf("spotify:track:%022d", id),
+				Uid: fmt.Sprintf("set-%d-track-%d", page, item),
+			})
+		}
+		r.pages = append(r.pages, tracks)
+	}
+	return r
+}
+
+func (*djCursorResolver) Type() librespot.SpotifyIdType { return librespot.SpotifyIdTypeTrack }
+func (*djCursorResolver) Uri() string {
+	return "spotify:playlist:37i9dQZF1EYkqdzj48dyYq"
+}
+func (*djCursorResolver) Metadata() map[string]string { return nil }
+
+func (r *djCursorResolver) Page(_ context.Context, index int) ([]*connectpb.ContextTrack, error) {
+	if index < 0 || index >= len(r.pages) {
+		return nil, io.EOF
+	}
+	r.loaded[index] = true
+	r.furthest = max(r.furthest, index)
+	return r.pages[index], nil
+}
+
+func djCursorForPage(page int) string {
+	return fmt.Sprintf("hm://lexicon-session-provider/context-resolve/v2/session/test?previousSegmentId=set-%d", page)
+}
+
+func (r *djCursorResolver) PageNextURL(index int) (string, bool) {
+	if !r.loaded[index] {
+		return "", false
+	}
+	return djCursorForPage(index), true
+}
+
+func newDJCursorList(t *testing.T) (*List, *djCursorResolver) {
+	t.Helper()
+	r := newDJCursorResolver()
+	list := newTrackList(&librespot.NullLogger{}, r)
+	if !list.GoStart(t.Context()) {
+		t.Fatal("could not start the first DJ set")
+	}
+	return list, r
+}
+
+func TestDJCursorSnapshotUsesCurrentPageDespiteLookahead(t *testing.T) {
+	list, resolver := newDJCursorList(t)
+	for attempt := range 2 {
+		snap := list.Snapshot(t.Context(), nil)
+		if resolver.furthest <= 0 {
+			t.Fatal("test did not fetch future pages while building the upcoming window")
+		}
+		if !snap.HasPageContinuation || snap.PageNextURL != djCursorForPage(0) {
+			t.Fatalf("snapshot %d bookmarked prefetched pages: continuation=%t, URL=%q", attempt, snap.HasPageContinuation, snap.PageNextURL)
+		}
+		if snap.Current.Uid != "set-0-track-0" || snap.Index.Page != 0 {
+			t.Fatalf("lookahead moved the playing track: %v", snap.Current)
+		}
+	}
+}
+
+func TestDJCursorFollowsCurrentPageAfterSeveralSets(t *testing.T) {
+	list, resolver := newDJCursorList(t)
+	firstURI := list.CurrentTrack().Uri
+	if err := list.Seek(t.Context(), func(track *connectpb.ContextTrack) bool {
+		return track.Uid == "set-3-track-0"
+	}); err != nil {
+		t.Fatal(err)
+	}
+	snap := list.Snapshot(t.Context(), nil)
+	if snap.Current.Uri != firstURI {
+		t.Fatal("test must use repeated songs with distinct occurrences")
+	}
+	if resolver.furthest <= 3 {
+		t.Fatal("test did not prefetch beyond the current set")
+	}
+	if !snap.HasPageContinuation || snap.PageNextURL != djCursorForPage(3) {
+		t.Fatalf("later set has wrong continuation: %t, %q", snap.HasPageContinuation, snap.PageNextURL)
+	}
+
+	// Going back to an earlier set must describe that actual page, rather
+	// than the highest page visited or fetched during the session.
+	if !list.GoPrev() {
+		t.Fatal("could not move to the previous set")
+	}
+	snap = list.Snapshot(t.Context(), nil)
+	if snap.Current.Uid != "set-2-track-4" || !snap.HasPageContinuation || snap.PageNextURL != djCursorForPage(2) {
+		t.Fatalf("previous set has wrong continuation: track=%v, continuation=%t, URL=%q", snap.Current, snap.HasPageContinuation, snap.PageNextURL)
+	}
+}
+
+func TestDJCursorExcludesTracksOutsideContextPages(t *testing.T) {
+	for _, kind := range []string{"queued", "injected"} {
+		t.Run(kind, func(t *testing.T) {
+			list, _ := newDJCursorList(t)
+			if kind == "queued" {
+				// Even a queued copy of a song in the current DJ set is not a
+				// new position in that set.
+				list.AddToQueue(&connectpb.ContextTrack{Uri: list.CurrentTrack().Uri, Uid: "queued-copy"})
+				if !list.GoNext(t.Context()) {
+					t.Fatal("could not play the queued track")
+				}
+			} else if err := list.TrySeekTo(t.Context(), &connectpb.ContextTrack{
+				Uri: "spotify:track:0000000000000000009999", Uid: "injected-track",
+			}); err != nil {
+				t.Fatal(err)
+			}
+			snap := list.Snapshot(t.Context(), nil)
+			if snap.HasPageContinuation || snap.PageNextURL != "" {
+				t.Fatalf("%s track was treated as a played context page: %t, %q", kind, snap.HasPageContinuation, snap.PageNextURL)
+			}
+			if snap.Index.Page != 0 || snap.Index.Track != 0 {
+				t.Fatal("test must cover the ambiguous zero context index")
+			}
+		})
+	}
+}
+
+func TestDJCursorIsOptionalForOtherResolvers(t *testing.T) {
+	// Hide the optional method, preserving the original resolver contract.
+	resolver := struct{ ContextResolver }{newDJCursorResolver()}
+	list := newTrackList(&librespot.NullLogger{}, resolver)
+	if !list.GoStart(t.Context()) {
+		t.Fatal("could not start the context")
+	}
+	snap := list.Snapshot(t.Context(), nil)
+	if snap.HasPageContinuation || snap.PageNextURL != "" {
+		t.Fatalf("resolver without page continuation returned a cursor: %t, %q", snap.HasPageContinuation, snap.PageNextURL)
+	}
+}
