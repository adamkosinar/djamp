+		}
+		if item.Uri != wantURI || item.AddedAt != wantAddedAt || item.IsRemoved != (index == 2) || item.ContextUri != nil {
+			t.Fatalf("write %d got %#v, want URI=%s timestamp=%d removed=%v", index, item, wantURI, wantAddedAt, index == 2)
