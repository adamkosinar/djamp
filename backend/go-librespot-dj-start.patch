diff --git a/daemon/playback_recovery.go b/daemon/playback_recovery.go
new file mode 100644
index 0000000..f811971
--- /dev/null
+++ b/daemon/playback_recovery.go
@@ -0,0 +1,156 @@
+package daemon
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/devgianlu/go-librespot/audio"
+	"github.com/devgianlu/go-librespot/mpris"
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+	"github.com/devgianlu/go-librespot/tracks"
+)
+
+// Audio-key error codes are opaque. A refusal says nothing reliable about a
+// track's availability or HTTP rate limiting. Stop new key requests for a
+// bounded interval and require an explicit user action to try again.
+const audioKeyCooldown = 10 * time.Second
+const audioKeyFailureMessage = "Spotify refused the audio key. Playback stopped; retry after the cooldown."
+
+var errPlaybackCooldown = errors.New("Playback is cooling down after an audio-key refusal; retry shortly.")
+
+func isAudioKeyRefusal(err error) bool {
+	var keyErr *audio.KeyProviderError
+	return errors.As(err, &keyErr)
+}
+
+func (l *loaderLane) cooldownRemaining() time.Duration {
+	if l == nil {
+		return 0
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return max(0, time.Until(l.audioKeyRetryAt))
+}
+
+// Run on the loader lane before publishing its result, so even a slow player
+// loop cannot let queued navigation or another stream request through. This
+// deadline is never extended by controls or by observing the same result.
+func (l *loaderLane) refuseAudioKey() time.Time {
+	l.mu.Lock()
+	if !time.Now().Before(l.audioKeyRetryAt) {
+		l.audioKeyRetryAt = time.Now().Add(audioKeyCooldown)
+	}
+	until := l.audioKeyRetryAt
+	dropped, kept := partitionQueue(l.queue, func(job loaderJob) bool { return job.class != classMutate })
+	l.queue = kept
+	l.mu.Unlock()
+	replyAll(dropped, errPlaybackCooldown)
+	return until
+}
+
+func (p *AppPlayer) playbackCooldownError() error {
+	if p.recoverySelecting || p.loader.cooldownRemaining() > 0 {
+		return errPlaybackCooldown
+	}
+	return nil
+}
+
+func (p *AppPlayer) apiPlaybackError() *ApiPlaybackError {
+	if p.playbackFailure == nil {
+		return nil
+	}
+	out := *p.playbackFailure
+	// Round up so a positive remainder never advertises an early retry.
+	out.RetryAfterMs = int64((p.loader.cooldownRemaining() + time.Millisecond - 1) / time.Millisecond)
+	if p.recoverySelecting {
+		out.RetryAfterMs = max(1, out.RetryAfterMs)
+	}
+	return &out
+}
+
+// Keep the context, track selection and DJ continuation intact. Unlike
+// stopPlayback, failure does not relinquish the session or consume its cursor.
+func (p *AppPlayer) stopForAudioKey() {
+	p.playbackFailure = &ApiPlaybackError{
+		Kind:    playbackErrorKindAudioKeyRefused,
+		Message: audioKeyFailureMessage,
+		Uri:     p.state.player.Track.GetUri(),
+	}
+	p.holdFailedPlayback()
+}
+
+// Settle a failed manual retry without forgetting its selection or error.
+func (p *AppPlayer) holdFailedPlayback() {
+	if p.playbackFailure != nil {
+		p.playbackFailure.Uri = p.state.player.Track.GetUri()
+	}
+	p.prefetchKeyFailure = false
+	p.loadGen++
+	p.prefetchGen++
+	p.loader.dropPlayback()
+	p.loadInFlight = false
+	p.recoverySelecting = false
+	p.pendingPlayerEvents = nil
+	p.prefetchTimer.Stop()
+	p.player.Stop()
+	p.primaryStream = nil
+	p.clearUpcoming()
+	p.state.updateTimestamp()
+	p.state.player.IsPlaying = false
+	p.state.player.IsBuffering = false
+	p.state.setPaused(true)
+	p.consecutiveUnplayableSkips = 0
+	p.updateState()
+	p.emitMprisUpdate(mpris.Stopped)
+}
+
+// A healthy primary may finish before a refused prefetch's cooldown expires.
+// Move only the retry selection to its successor; never fetch media or consume
+// a DJ cursor. This explicit navigation is the one exception to dropping
+// ordinary queued controls during recovery.
+func (p *AppPlayer) stopAfterPrefetchRefusal() {
+	p.stopForAudioKey()
+	p.state.player.PositionAsOfTimestamp = 0
+	if p.state.player.Options.RepeatingTrack {
+		return
+	}
+	gen := p.loadGen
+	p.recoverySelecting = true
+	var hasNext bool
+	// An explicit empty hint avoids fetching surrounding pages just to select
+	// the retry target, which the refused prefetch already resolved.
+	p.listJob("select next after refused prefetch", classMutate, []*connectpb.ContextTrack{},
+		func(ctx context.Context, list *tracks.List) error { hasNext = list.GoNext(ctx); return nil },
+		func(p *AppPlayer, snap *tracks.Snapshot, err error) {
+			if gen != p.loadGen {
+				return
+			}
+			p.recoverySelecting = false
+			if err != nil || p.playbackFailure == nil {
+				return
+			}
+			if hasNext {
+				p.publishSnapshot(snap)
+			} else {
+				p.state.player.Track = nil
+			}
+			p.state.player.PositionAsOfTimestamp = 0
+			p.state.player.Timestamp = time.Now().UnixMilli()
+			p.playbackFailure.Uri = p.state.player.Track.GetUri()
+			p.updateState()
+		})
+}
+
+// Unlike normal supersession, a failed playback attempt abandons relative
+// navigation too: queued controls must not consume the retained selection.
+func (l *loaderLane) dropPlayback() {
+	l.mu.Lock()
+	dropped, kept := partitionQueue(l.queue, func(job loaderJob) bool { return job.class != classMutate })
+	l.queue = kept
+	if l.running != nil && l.running.class != classMutate {
+		l.running.cancel()
+	}
+	l.mu.Unlock()
+	replyAll(dropped, ErrSuperseded)
+}
