+syntax = "proto3";
+package spotify.collection.proto.v2;
+option go_package = "github.com/devgianlu/go-librespot/proto/spotify/collection/v2;collectionpb";
+
+// Minimal collection-v2 wire schema, corroborated against collection2v2.proto
+// embedded in the Spotify desktop client. Unknown item data remains opaque.
+message PageRequest {
+  string username = 1;
+  string set = 2;
+  string pagination_token = 3;
+  int32 limit = 4;
+}
+message CollectionItem {
+  string uri = 1;
+  int64 added_at = 2;
+  bool is_removed = 3;
+  optional string context_uri = 4;
+}
+message PageResponse {
+  repeated CollectionItem items = 1;
+  string next_page_token = 2;
+  string sync_token = 3;
+}
+message WriteRequest {
+  string username = 1;
+  string set = 2;
+  repeated CollectionItem items = 3;
+  string client_update_id = 4;
+}
