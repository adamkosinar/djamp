+	"time"
+
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/audio"
+	"github.com/devgianlu/go-librespot/dealer"
+	"github.com/devgianlu/go-librespot/player"
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+	"github.com/devgianlu/go-librespot/session"
+	"github.com/devgianlu/go-librespot/tracks"
+	"github.com/stretchr/testify/require"
+)
+
+func recoveryPlayer(t *testing.T) *AppPlayer {
+	t.Helper()
+	p := newTestAppPlayer(t)
+	p.app.cfg = &Config{DisableAutoplay: true}
+	p.app.metaCache = newTrackMetaCache()
+	p.app.state = &librespot.AppState{}
+	p.prodInfo = &ProductInfo{}
+	ctx := &connectpb.Context{Uri: djContextURI, Pages: []*connectpb.ContextPage{{
+		Tracks: []*connectpb.ContextTrack{{Uri: trackUri(1)}, {Uri: trackUri(2)}, {Uri: trackUri(3)}},
+	}}}
+	list, err := tracks.NewTrackListFromContext(t.Context(), p.app.log, nil, ctx)
+	require.NoError(t, err)
+	require.True(t, list.GoStart(t.Context()))
+	p.state.tracks = list
+	p.state.player.ContextUri = ctx.Uri
+	p.publishSnapshot(list.Snapshot(t.Context(), []*connectpb.ContextTrack{}))
+	return p
+}
+
+func expireAudioCooldown(l *loaderLane) {
+	l.mu.Lock()
+	l.audioKeyRetryAt = time.Now().Add(-time.Second)
+	l.mu.Unlock()
+}
+
+func refuseCurrentTrack(t *testing.T, p *AppPlayer) {
+	t.Helper()
+	p.streamFactory = func(context.Context, librespot.SpotifyId, int64) (*player.Stream, error) {
+		return nil, fmt.Errorf("opaque backend detail https://secret.invalid/?token=hidden: %w", &audio.KeyProviderError{Code: 2})
+	}
+	p.loadCurrentTrackOrSkip(false, true, false, func(error) {})
+	require.True(t, p.loadInFlight)
+	runQueuedJob(t, p)
+}
+
+func TestAudioKeyRefusalStopsWithoutSkippingAndPreservesDJ(t *testing.T) {
+	p := recoveryPlayer(t)
+	p.djPlayback = &djPlayback{username: "test-account", rootFingerprint: "root", pending: &djPagePosition{nextPageURL: djPageURL(1), trackURI: trackUri(1)}}
+	want := p.state.tracks
+	refuseCurrentTrack(t, p)
+	require.Same(t, want, p.state.tracks)
+	require.Equal(t, trackUri(1), p.state.player.Track.GetUri())
+	require.Equal(t, trackUri(1), p.state.tracks.Snapshot(t.Context(), []*connectpb.ContextTrack{}).Current.Uri)
+	require.False(t, p.state.player.IsPlaying)
+	require.True(t, p.state.player.IsPaused)
+	require.False(t, p.state.player.IsBuffering)
+	require.False(t, p.loadInFlight)
+	require.Empty(t, p.loader.queue, "a key refusal must not walk the collection")
+	require.Nil(t, p.app.djCursor("test-account"))
+	require.NotNil(t, p.djPlayback)
+	require.NotNil(t, p.apiPlaybackError())
+	require.Equal(t, "audio_key_refused", p.apiPlaybackError().Kind)
+	require.Greater(t, p.apiPlaybackError().RetryAfterMs, int64(0))
+	require.LessOrEqual(t, p.apiPlaybackError().RetryAfterMs, int64(10000))
+	raw, err := json.Marshal(ApiStatus{ApiPlaybackError: p.apiPlaybackError()})
+	require.NoError(t, err)
+	require.Contains(t, string(raw), `"playback_error"`)
+	require.NotContains(t, string(raw), "secret.invalid")
+	require.NotContains(t, string(raw), "hidden")
+	for _, event := range p.app.server.(*recordingApiServer).emitted {
+		if event.Type == ApiEventTypePlaybackError {
+			data := event.Data.(ApiEventDataPlaybackError)
+			require.False(t, data.Unplayable)
+			require.Equal(t, audioKeyFailureMessage, data.Message)
+		}
+	}
+	// Deferred and newly arriving old output events cannot restart or advance.
+	for _, kind := range []player.EventType{player.EventTypePlay, player.EventTypeResume, player.EventTypeNotPlaying} {
+		p.handlePlayerEvent(&player.Event{Type: kind})
+	}
+	require.False(t, p.state.player.IsPlaying)
+	require.Empty(t, p.loader.queue)
+}
+
+func TestRecoveryControlsCannotBypassOrExtendCooldown(t *testing.T) {
+	p := recoveryPlayer(t)
+	refuseCurrentTrack(t, p)
+	deadline := p.loader.audioKeyRetryAt
+	for i := 0; i < 64; i++ {
+		for _, kind := range []ApiRequestType{ApiRequestTypePlay, ApiRequestTypeResume, ApiRequestTypePlayPause, ApiRequestTypeNext, ApiRequestTypePrev} {
+			_, err := p.handleApiRequest(ApiRequest{Type: kind})
+			require.ErrorIs(t, err, errPlaybackCooldown)
+		}
+		for _, endpoint := range []string{"play", "resume", "transfer", "skip_next", "skip_prev"} {
+			req := dealer.RequestPayload{}
+			req.Command.Endpoint = endpoint
+			require.ErrorIs(t, p.handlePlayerCommand(req), errPlaybackCooldown)
+		}
+		p.prefetchNext()
+		require.ErrorIs(t, p.play(), errPlaybackCooldown)
+		require.ErrorIs(t, p.skipNext(nil), errPlaybackCooldown)
+		require.ErrorIs(t, p.skipPrev(true), errPlaybackCooldown)
+	}
+	require.Equal(t, deadline, p.loader.audioKeyRetryAt)
+	require.Empty(t, p.loader.queue)
+	require.Equal(t, trackUri(1), p.state.player.Track.Uri)
+}
+
+func TestCooldownExpiresWithoutAutomaticRetryAndManualResumeRecovers(t *testing.T) {
+	p := recoveryPlayer(t)
+	refuseCurrentTrack(t, p)
+	expireAudioCooldown(p.loader)
+	require.Zero(t, p.apiPlaybackError().RetryAfterMs)
+	require.Empty(t, p.loader.queue)
+	require.NoError(t, p.play())
+	require.True(t, p.state.player.IsBuffering)
+	require.NotNil(t, p.apiPlaybackError(), "input cannot clear the persistent error")
+	require.Len(t, p.loader.queue, 1)
+	require.Equal(t, "load "+trackUri(1), p.loader.queue[0].name)
+	// A failed retry stays stopped, on precisely the same selection.
+	runQueuedJob(t, p)
+	require.False(t, p.state.player.IsBuffering)
+	require.NotNil(t, p.apiPlaybackError())
+	require.Equal(t, trackUri(1), p.apiPlaybackError().Uri)
+	expireAudioCooldown(p.loader)
+	require.NoError(t, p.play())
+	job := p.loader.queue[0]
+	p.loader.queue = nil
+	stream := &player.Stream{RequestedId: librespot.SpotifyIdFromGid(librespot.SpotifyIdTypeTrack, gid(1)), Media: librespot.NewMediaFromTrack(metaTrack(gid(1), "Recovered"))}
+	p.applyLoaderResult(loaderResult{class: classLoad, gen: job.gen, commit: func(p *AppPlayer, _ error) { p.commitLoad(stream, trackUri(1), false, 0, false) }})
+	require.Nil(t, p.apiPlaybackError())
+	require.True(t, p.state.player.IsPlaying)
+	require.False(t, p.state.player.IsBuffering)
+}
+
+func TestAudioKeyRefusalGatePrecedesResultAndDropsQueuedNavigation(t *testing.T) {
+	l := newTestLoaderLane()
+	ran := 0
+	job := loaderJob{class: classLoad, run: func(context.Context) loaderResult { return loaderResult{err: &audio.KeyProviderError{Code: 2}} }}
+	l.queue = []loaderJob{{class: classNav, run: func(context.Context) loaderResult { ran++; return loaderResult{} }}, {class: classLoad}, {class: classPrefetch}, {class: classMutate, run: func(context.Context) loaderResult { ran++; return loaderResult{} }}}
+	result := l.execute(job, t.Context())
+	require.True(t, isAudioKeyRefusal(result.err))
+	require.Len(t, l.queue, 1)
+	require.Equal(t, classMutate, l.queue[0].class)
+	for _, class := range []loaderClass{classLoad, classNav, classPrefetch} {
+		reply, answered := recordingReply(t)
+		l.submit(loaderJob{class: class, reply: reply, run: func(context.Context) loaderResult { ran++; return loaderResult{} }})
+		err, ok := answered()
+		require.True(t, ok)
+		require.ErrorIs(t, err, errPlaybackCooldown)
+		rejected := l.execute(loaderJob{class: class, run: func(context.Context) loaderResult { ran++; return loaderResult{} }}, t.Context())
+		require.ErrorIs(t, rejected.err, errPlaybackCooldown)
+	}
+	require.Zero(t, ran, "no request or list mutation before the player receives the failure")
+	l.execute(l.queue[0], t.Context())
+	require.Equal(t, 1, ran, "library/queue mutations remain independent")
+}
+
+func TestStaleRefusalPreservesHealthyPrimaryAndStaleSuccessCannotClearFailure(t *testing.T) {
+	p := recoveryPlayer(t)
+	healthy := playingTrack(t, p, trackUri(1), "one")
+	p.loadGen = 3
+	p.applyLoaderResult(loaderResult{class: classLoad, gen: 2, err: &audio.KeyProviderError{Code: 2}})
+	require.Same(t, healthy, p.primaryStream)
+	require.True(t, p.state.player.IsPlaying)
+	require.Nil(t, p.apiPlaybackError())
+	require.Equal(t, trackUri(1), p.state.player.Track.Uri)
+	require.Greater(t, p.loader.cooldownRemaining(), time.Duration(0))
+	p.stopForAudioKey()
+	p.applyLoaderResult(loaderResult{class: classLoad, gen: 2, commit: func(p *AppPlayer, _ error) { p.playbackFailure = nil }})
+	require.NotNil(t, p.apiPlaybackError())
+}
+
+func TestPrefetchRefusalKeepsPrimaryThenSelectsNextOnEarlyEnd(t *testing.T) {
+	for _, repeat := range []bool{false, true} {
+		t.Run(fmt.Sprint("repeat=", repeat), func(t *testing.T) {
+			p := recoveryPlayer(t)
+			healthy := playingTrack(t, p, trackUri(1), "one")
+			p.state.player.Options.RepeatingTrack = repeat
+			p.applyLoaderResult(loaderResult{class: classPrefetch, gen: p.prefetchGen, err: &audio.KeyProviderError{Code: 2}})
+			require.Same(t, healthy, p.primaryStream)
+			require.True(t, p.state.player.IsPlaying)
+			require.False(t, p.state.player.IsBuffering)
+			require.Nil(t, p.apiPlaybackError())
+			p.handlePlayerEvent(&player.Event{Type: player.EventTypeNotPlaying})
+			require.Nil(t, p.primaryStream)
+			require.False(t, p.state.player.IsBuffering)
+			want := trackUri(1)
+			if !repeat {
+				require.True(t, p.recoverySelecting)
+				expireAudioCooldown(p.loader)
+				require.ErrorIs(t, p.play(), errPlaybackCooldown, "cannot capture the old track while successor selection is pending")
