+
+	librespot "github.com/devgianlu/go-librespot"
+	collectionpb "github.com/devgianlu/go-librespot/proto/spotify/collection/v2"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/protobuf/proto"
+)
+
+type collectionRoundTrip func(*http.Request) (*http.Response, error)
+
+func (f collectionRoundTrip) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+func collectionTestClient(t *testing.T, fn collectionRoundTrip) *Spclient {
+	t.Helper()
+	base, err := url.Parse("https://collection.test/")
+	require.NoError(t, err)
+	return &Spclient{log: &librespot.NullLogger{}, baseUrl: base, client: &http.Client{Transport: fn}, accessToken: func(context.Context, bool) (string, error) { return "test-token", nil }}
+}
+func collectionTestResponse(status int, body []byte) *http.Response {
+	return &http.Response{StatusCode: status, Body: io.NopCloser(bytes.NewReader(body)), Header: http.Header{}}
+}
+
+func TestCollectionPagePreservesVendorHeadersAndTypedPayload(t *testing.T) {
+	request := &collectionpb.PageRequest{Username: "test-account", Set: "collection", PaginationToken: "next-page", Limit: 3}
+	want := &collectionpb.PageResponse{Items: []*collectionpb.CollectionItem{{Uri: "spotify:track:0000000000000000000001", AddedAt: 1 << 35}}, NextPageToken: "later"}
+	c := collectionTestClient(t, func(r *http.Request) (*http.Response, error) {
+		require.Equal(t, "POST", r.Method)
+		require.Equal(t, "/collection/v2/paging", r.URL.Path)
+		require.Equal(t, collectionContentType, r.Header.Get("Content-Type"))
+		require.Equal(t, collectionContentType, r.Header.Get("Accept"))
+		require.Equal(t, "Bearer test-token", r.Header.Get("Authorization"))
+		raw, err := io.ReadAll(r.Body)
+		require.NoError(t, err)
+		var got collectionpb.PageRequest
+		require.NoError(t, proto.Unmarshal(raw, &got))
+		require.True(t, proto.Equal(request, &got))
+		raw, err = proto.Marshal(want)
+		require.NoError(t, err)
+		return collectionTestResponse(200, raw), nil
+	})
+	got, err := c.CollectionPage(t.Context(), request)
+	require.NoError(t, err)
+	require.True(t, proto.Equal(want, got))
+}
+func TestCollectionPageAllowsEmptyProtoAndRejectsInvalidResponses(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		status    int
+		raw       []byte
+		wantError bool
+	}{
+		{"empty library", 200, nil, false}, {"no content is not a page", 204, nil, true}, {"forbidden", 403, nil, true},
+		{"invalid protobuf", 200, []byte{0xff}, true}, {"oversized", 200, make([]byte, maxCollectionResponse+1), true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			c := collectionTestClient(t, func(*http.Request) (*http.Response, error) { return collectionTestResponse(tc.status, tc.raw), nil })
+			got, err := c.CollectionPage(t.Context(), &collectionpb.PageRequest{Username: "account", Set: "collection", Limit: 300})
+			if tc.wantError {
+				require.Error(t, err)
+				require.Nil(t, got)
+			} else {
+				require.NoError(t, err)
+				require.Empty(t, got.Items)
+				require.Empty(t, got.NextPageToken)
+			}
+		})
+	}
+}
+func TestCollectionWriteConfirmsOnlySuccessfulResponse(t *testing.T) {
+	for _, status := range []int{200, 204, 403, 429} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			want := &collectionpb.WriteRequest{Username: "test-account", Set: "collection", ClientUpdateId: "d370f4f9-ea85-45a0-874f-754ac2b3c4a5", Items: []*collectionpb.CollectionItem{{Uri: "spotify:track:0000000000000000000001", IsRemoved: true}}}
+			c := collectionTestClient(t, func(r *http.Request) (*http.Response, error) {
+				require.Equal(t, "/collection/v2/write", r.URL.Path)
+				require.Equal(t, collectionContentType, r.Header.Get("Content-Type"))
+				raw, err := io.ReadAll(r.Body)
+				require.NoError(t, err)
+				var got collectionpb.WriteRequest
+				require.NoError(t, proto.Unmarshal(raw, &got))
+				require.True(t, proto.Equal(want, &got))
+				return collectionTestResponse(status, nil), nil
+			})
+			err := c.CollectionWrite(t.Context(), want)
+			if status < 300 {
+				require.NoError(t, err)
+			} else {
+				require.Error(t, err)
+			}
+		})
+	}
+}
